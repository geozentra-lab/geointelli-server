APP_PORT=8082
# Match the issuer used by property-service and the frontend's access tokens.
KEYCLOAK_ISSUER_URI=http://localhost:8090/realms/geozentra
# Optional: KEYCLOAK_JWK_SET_URI (override when Keycloak keys use a different internal address).
DB_HOST=localhost
DB_PORT=5432
DB_NAME=geozentra_notifications
DB_USER=postgres
DB_PASSWORD=
DB_SSL_MODE=prefer
DB_SSL_ROOT_CERT=
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_VHOST=/
NOTIFICATIONS_CONSUMER_ENABLED=true
NOTIFICATIONS_CONSUMERS=1
NOTIFICATIONS_MAX_CONSUMERS=2
NOTIFICATIONS_PREFETCH=5
NOTIFICATIONS_MAX_ATTEMPTS=3
NOTIFICATIONS_RETRY_INITIAL_MILLIS=1000
NOTIFICATIONS_RETRY_MAX_MILLIS=10000
NOTIFICATIONS_CONFIRM_TIMEOUT_SECONDS=10
ALERTS_EXCHANGE=geozentra.alerts
ALERTS_QUEUE=geozentra.notifications.alerts
ALERTS_ROUTING_KEY=alerts.v1
NOTIFICATIONS_DLX=geozentra.notifications.dead
NOTIFICATIONS_DLQ=geozentra.notifications.alerts.dlq
NOTIFICATIONS_DLQ_ROUTING_KEY=alerts.failed.v1

# Docker app connects to the same broker as property-service.
# Create this non-guest user on that broker and grant access to RABBITMQ_VHOST.
DOCKER_RABBITMQ_HOST=host.docker.internal
DOCKER_RABBITMQ_PORT=5672
DOCKER_RABBITMQ_USERNAME=geozentra
DOCKER_RABBITMQ_PASSWORD=
