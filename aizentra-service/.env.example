# Copy to .env for local runs. Shared environments get real values from their deployment, never from git.

# OpenAI-compatible model server: Ollama locally, vLLM in production.
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=qwen3:8b
# Ollama ignores the key; vLLM checks it when started with --api-key.
LLM_API_KEY=ollama
# Qwen3 only: false skips the model's hidden reasoning step. Much faster, but small models then
# skip tools and invent figures; keep true unless an eval shows the model still calls tools.
LLM_THINKING=true

# Spring property-service at its APP_PORT (8081 is the Docker Compose default host port).
PROPERTY_SERVICE_URL=http://localhost:8081

# Shared secret Spring sends in the X-Internal-Token header (at least 16 characters).
INTERNAL_TOKEN=local-dev-internal-token-change-me

# Most model <-> tool rounds for one question.
MAX_TOOL_ROUNDS=4

# Temporary test page at /playground. Local development only.
PLAYGROUND_ENABLED=false
