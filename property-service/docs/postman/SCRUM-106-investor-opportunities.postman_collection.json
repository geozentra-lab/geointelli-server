{
  "info": {
    "name": "SCRUM-106 Investor dashboard opportunities card",
    "description": "GET /api/dashboards/investor/opportunities: bounded list of the best stored opportunity scores (shared service of SCRUM-76) with their ranking explanation and evidence coverage, flagged when already held. Variables: baseUrl, user_a_token (investor with portfolios), admin_token (any user without portfolios), portfolioId (one of user A's portfolios), heldPropertyId (a scored property held in that portfolio), otherUsersPortfolioId, countyId and countyName (a county with scored properties). Run in order.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{user_a_token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8081"
    },
    {
      "key": "user_a_token",
      "value": ""
    },
    {
      "key": "admin_token",
      "value": ""
    },
    {
      "key": "portfolioId",
      "value": "1"
    },
    {
      "key": "heldPropertyId",
      "value": "1"
    },
    {
      "key": "otherUsersPortfolioId",
      "value": "3"
    },
    {
      "key": "countyId",
      "value": "2"
    },
    {
      "key": "countyName",
      "value": "Broward"
    },
    {
      "key": "bestPropertyId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "01 Card without token (401)",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/api/dashboards/investor/opportunities",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "dashboards",
            "investor",
            "opportunities"
          ]
        },
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "auth": {
          "type": "noauth"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status 401', () => pm.response.to.have.status(401));"
            ]
          }
        }
      ]
    },
    {
      "name": "02 Card, all my portfolios (default limit 5)",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/api/dashboards/investor/opportunities",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "dashboards",
            "investor",
            "opportunities"
          ]
        },
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "description": "Needs at least one SCORED row in property_opportunity_scores (run the SCRUM-76 refresh, or seed scores locally)."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status 200', () => pm.response.to.have.status(200));",
              "const c = pm.response.json();",
              "pm.test('OK card of the shared browse', () => { pm.expect(c.scope).to.eql('ALL_PORTFOLIOS'); pm.expect(c.portfolioId).to.eql(null); pm.expect(c.status).to.eql('OK'); pm.expect(c.candidateStatus).to.eql('OK'); pm.expect(c.scoreVersion).to.eql('opportunity-v1'); pm.expect(c.limit).to.eql(5); pm.expect(c.items.length).to.be.at.most(5); pm.expect(c.totalCandidates).to.be.at.least(c.items.length); pm.expect(c.notes).to.be.an('array').that.is.not.empty; pm.expect(c.generatedAt).to.be.a('string'); });",
              "pm.test('best first', () => { for (let k = 1; k < c.items.length; k++) pm.expect(c.items[k-1].score).to.be.at.least(c.items[k].score); });",
              "pm.test('items keep the shared explanation and coverage', () => c.items.forEach(i => { pm.expect(i.score).to.be.a('number'); pm.expect(i.maxScore).to.eql(100); pm.expect(i.coveragePercent).to.be.a('number'); pm.expect(i.factors.length).to.eql(7); pm.expect(i.factors[0]).to.have.all.keys('code','label','category','weight','status','signal','signalUnit','subscore','points','explanation'); pm.expect(i).to.have.property('alreadyHeld'); }));",
              "pm.collectionVariables.set('bestPropertyId', c.items[0].propertyId);"
            ]
          }
        }
      ]
    },
    {
      "name": "03 alreadyHeld flags my holdings",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/api/dashboards/investor/opportunities",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "dashboards",
            "investor",
            "opportunities"
          ]
        },
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "description": "Variable heldPropertyId: a property held in one of user A's portfolios that is also among the best scores."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status 200', () => pm.response.to.have.status(200));",
              "const c = pm.response.json();",
              "pm.test('held properties are flagged, others not', () => { const held = c.items.filter(i => i.alreadyHeld).map(i => i.propertyId); pm.expect(held).to.include(Number(pm.collectionVariables.get('heldPropertyId'))); pm.expect(c.items.filter(i => !i.alreadyHeld).length).to.be.above(0); });"
            ]
          }
        }
      ]
    },
    {
      "name": "04 Card of one of my portfolios (PORTFOLIO scope)",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/api/dashboards/investor/opportunities?portfolioId={{portfolioId}}",
          "host": [
            "{{baseUrl}}"
