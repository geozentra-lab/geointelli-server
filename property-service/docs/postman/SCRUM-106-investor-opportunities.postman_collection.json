          }
        ]
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status 200', () => pm.response.to.have.status(200));",
              "const c = pm.response.json();",
              "pm.test('scope PORTFOLIO, held flag limited to that portfolio', () => { pm.expect(c.scope).to.eql('PORTFOLIO'); pm.expect(c.portfolioId).to.eql(Number(pm.collectionVariables.get('portfolioId'))); pm.expect(c.portfolioCount).to.eql(1); pm.expect(c.items.filter(i => i.alreadyHeld).map(i => i.propertyId)).to.eql([Number(pm.collectionVariables.get('heldPropertyId'))]); });"
            ]
          }
        }
      ]
    },
