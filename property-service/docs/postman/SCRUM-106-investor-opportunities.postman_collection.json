              "const c = pm.response.json();",
              "pm.test('exactly 2 items, total unchanged', () => { pm.expect(c.limit).to.eql(2); pm.expect(c.items.length).to.eql(2); pm.expect(c.totalCandidates).to.be.above(2); pm.expect(c.items[0].propertyId).to.eql(Number(pm.collectionVariables.get('bestPropertyId'))); });",
              "pm.test('best first', () => { for (let k = 1; k < c.items.length; k++) pm.expect(c.items[k-1].score).to.be.at.least(c.items[k].score); });"
            ]
          }
        }
      ]
