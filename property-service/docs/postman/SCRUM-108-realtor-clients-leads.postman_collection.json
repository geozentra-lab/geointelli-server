                  "const b = pm.response.json();",
                  "pm.test('envelope', () => { pm.expect(b.scope).to.eql('CURRENT_USER'); pm.expect(b.status).to.eql('OK'); pm.expect(b.error).to.be.null; pm.expect(b.generatedAt).to.be.a('string'); });",
                  "pm.test('all five stages present and total = sum', () => { ['NEW', 'CONTACTED', 'QUALIFIED', 'CONVERTED', 'LOST'].forEach(s => pm.expect(b.leads.byStage).to.have.property(s)); const sum = Object.values(b.leads.byStage).reduce((a, c) => a + c, 0); pm.expect(b.leads.total).to.eql(sum); pm.expect(b.leads.open).to.eql(b.leads.byStage.NEW + b.leads.byStage.CONTACTED + b.leads.byStage.QUALIFIED); });",
                  "pm.test('recent lists are bounded by limit and newest first', () => { [b.clients.recent, b.leads.recent].forEach(list => { pm.expect(list.length).to.be.at.most(b.limit); for (let i = 1; i < list.length; i++) pm.expect(list[i - 1].createdAt >= list[i].createdAt, list[i - 1].createdAt + ' >= ' + list[i].createdAt).to.be.true; }); });",
                  "pm.test('items have the documented fields', () => { b.clients.recent.forEach(c => ['id', 'name', 'email', 'phone', 'createdAt'].forEach(k => pm.expect(c).to.have.property(k))); b.leads.recent.forEach(l => ['id', 'clientId', 'clientName', 'propertyId', 'title', 'source', 'stage', 'createdAt'].forEach(k => pm.expect(l).to.have.property(k))); });",
                  "const id = k => Number(pm.collectionVariables.get(k));",
                  "pm.test('counts: 2 clients, 3 leads, 2 open', () => { pm.expect(b.limit).to.eql(5); pm.expect(b.clients.total).to.eql(2); pm.expect(b.leads.total).to.eql(3); pm.expect(b.leads.open).to.eql(2); });",
                  "pm.test('byStage: NEW 1, CONTACTED 1, LOST 1, others 0', () => { const s = b.leads.byStage; pm.expect(s.NEW).to.eql(1); pm.expect(s.CONTACTED).to.eql(1); pm.expect(s.QUALIFIED).to.eql(0); pm.expect(s.CONVERTED).to.eql(0); pm.expect(s.LOST).to.eql(1); });",
                  "pm.test('recent clients: Youssef then Amina', () => { pm.expect(b.clients.recent.map(c => c.id)).to.eql([id('clientId2'), id('clientId1')]); pm.expect(b.clients.recent[0].name).to.eql('Youssef Idrissi'); pm.expect(b.clients.recent[0].email).to.eql('youssef.idrissi@example.test'); });",
