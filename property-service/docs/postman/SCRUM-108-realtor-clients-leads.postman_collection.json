{
  "info": {
    "name": "SCRUM-108 Realtor dashboard: clients and leads card",
    "description": "GET /api/dashboards/realtor/clients-leads. Run folders in order with the Collection Runner. Needs a running service (baseUrl), a Keycloak realm (keycloakUrl, clientId) and two users: A, the realtor whose data is created in folder 2, and B, an outsider with no CRM data. propertyId must be an existing property id. Test rows cannot be deleted through the API (leads are permanent and clients with leads return 409), so re-running folder 2 adds more rows; use fresh users to re-run the exact count assertions.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "0 Tokens",
      "item": [
        {
          "name": "0.1 Token for user A (Keycloak password grant)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/x-www-form-urlencoded"
              }
            ],
            "url": {
              "raw": "{{keycloakUrl}}/protocol/openid-connect/token",
              "host": [
                "{{keycloakUrl}}"
              ],
              "path": [
                "protocol",
                "openid-connect",
                "token"
              ]
            },
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "client_id",
                  "value": "{{clientId}}"
                },
                {
                  "key": "grant_type",
                  "value": "password"
                },
                {
                  "key": "username",
                  "value": "{{userA}}"
                },
                {
                  "key": "password",
                  "value": "{{passwordA}}"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set('tokenA', pm.response.json().access_token);"
                ]
              }
            }
          ]
        },
        {
          "name": "0.2 Token for user B (Keycloak password grant)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/x-www-form-urlencoded"
              }
            ],
            "url": {
              "raw": "{{keycloakUrl}}/protocol/openid-connect/token",
              "host": [
                "{{keycloakUrl}}"
              ],
              "path": [
                "protocol",
                "openid-connect",
                "token"
              ]
            },
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "client_id",
                  "value": "{{clientId}}"
                },
                {
                  "key": "grant_type",
                  "value": "password"
                },
                {
                  "key": "username",
                  "value": "{{userB}}"
                },
                {
                  "key": "password",
                  "value": "{{passwordB}}"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set('tokenB', pm.response.json().access_token);"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "1 Empty card",
      "item": [
        {
          "name": "1.1 Card is empty for user A",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{tokenA}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/dashboards/realtor/clients-leads",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "dashboards",
                "realtor",
                "clients-leads"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "const b = pm.response.json();",
                  "pm.test('envelope', () => { pm.expect(b.scope).to.eql('CURRENT_USER'); pm.expect(b.status).to.eql('OK'); pm.expect(b.error).to.be.null; pm.expect(b.generatedAt).to.be.a('string'); });",
                  "pm.test('all five stages present and total = sum', () => { ['NEW', 'CONTACTED', 'QUALIFIED', 'CONVERTED', 'LOST'].forEach(s => pm.expect(b.leads.byStage).to.have.property(s)); const sum = Object.values(b.leads.byStage).reduce((a, c) => a + c, 0); pm.expect(b.leads.total).to.eql(sum); pm.expect(b.leads.open).to.eql(b.leads.byStage.NEW + b.leads.byStage.CONTACTED + b.leads.byStage.QUALIFIED); });",
                  "pm.test('recent lists are bounded by limit and newest first', () => { [b.clients.recent, b.leads.recent].forEach(list => { pm.expect(list.length).to.be.at.most(b.limit); for (let i = 1; i < list.length; i++) pm.expect(list[i - 1].createdAt >= list[i].createdAt, list[i - 1].createdAt + ' >= ' + list[i].createdAt).to.be.true; }); });",
                  "pm.test('items have the documented fields', () => { b.clients.recent.forEach(c => ['id', 'name', 'email', 'phone', 'createdAt'].forEach(k => pm.expect(c).to.have.property(k))); b.leads.recent.forEach(l => ['id', 'clientId', 'clientName', 'propertyId', 'title', 'source', 'stage', 'createdAt'].forEach(k => pm.expect(l).to.have.property(k))); });",
                  "pm.test('zeros and empty lists', () => { pm.expect(b.limit).to.eql(5); pm.expect(b.clients.total).to.eql(0); pm.expect(b.clients.recent).to.eql([]); pm.expect(b.leads.total).to.eql(0); pm.expect(b.leads.open).to.eql(0); pm.expect(b.leads.recent).to.eql([]); ['NEW', 'CONTACTED', 'QUALIFIED', 'CONVERTED', 'LOST'].forEach(s => pm.expect(b.leads.byStage[s]).to.eql(0)); });"
                ]
              }
            }
          ]
        }
      ]
    },
