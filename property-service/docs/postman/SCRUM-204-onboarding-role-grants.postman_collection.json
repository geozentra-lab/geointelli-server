    },
    {
      "name": "6. Clean up (re-run)",
      "item": [
        {
          "name": "Revoke lender",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/api/admin/users/{{user_id}}/roles/lender/revoke",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reason\": \"Postman test clean-up\"\n}"
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{admin_token}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 revoked, or 503 with role management off', () => pm.expect(pm.response.code).to.be.oneOf([200, 503]));"
                ]
              }
            }
          ]
        }
      ]
    },
