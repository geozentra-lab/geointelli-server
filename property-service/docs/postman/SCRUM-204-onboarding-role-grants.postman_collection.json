              "mode": "raw",
              "raw": "{\n  \"role\": \"realtor\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 400', () => pm.response.to.have.status(400));",
                  "pm.test('points to the license', () => pm.expect(pm.response.json().message).to.include('realtor-license'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Admin role: 400",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/api/users/me/role-requests",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"role\": \"admin\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 400', () => pm.response.to.have.status(400));"
                ]
              }
            }
          ]
        },
        {
          "name": "Request lender (no organization): 201 PENDING",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/api/users/me/role-requests",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"role\": \"lender\",\n  \"note\": \"SCRUM-204 Postman run\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 201', () => pm.response.to.have.status(201));",
                  "const r = pm.response.json();",
                  "pm.test('PENDING by default, APPROVED when lender is self-service', () => pm.expect(r.status).to.be.oneOf(['PENDING', 'APPROVED']));",
                  "if (r.status === 'APPROVED') pm.test('self-service reason and time', () => { pm.expect(r.decisionReason).to.include('self-service'); pm.expect(r.decidedAt).to.be.a('string'); });",
                  "pm.test('Location header', () => pm.expect(pm.response.headers.get('Location')).to.include('/api/users/me/role-requests/' + r.id));",
                  "pm.collectionVariables.set('request_id', r.id);",
                  "pm.collectionVariables.set('lender_status', r.status);"
                ]
              }
            }
          ]
        },
        {
          "name": "The request answered the onboarding page",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/api/users/me/entitlements"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "const r = pm.response.json();",
                  "const granted = pm.collectionVariables.get('lender_status') === 'APPROVED';",
                  "pm.test('onboardingCompleted', () => pm.expect(r.onboardingCompleted).to.eql(true));",
                  "pm.test('pendingRoles only while pending', () => granted ? pm.expect(r.pendingRoles).to.not.include('lender') : pm.expect(r.pendingRoles).to.include('lender'));",
                  "pm.collectionVariables.set('onboarded_at', r.onboardingCompletedAt);"
                ]
              }
            }
          ]
        },
        {
          "name": "Second lender request: 409",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/api/users/me/role-requests",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"role\": \"lender\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 409', () => pm.response.to.have.status(409));",
                  "const granted = pm.collectionVariables.get('lender_status') === 'APPROVED';",
                  "const message = (pm.response.json() || {}).message || '';",
                  "pm.test('granted: refresh the token; pending: already pending', () => pm.expect(message).to.include(granted ? 'refresh' : 'pending'));"
                ]
              }
            }
          ]
        }
      ]
    },
