    {
      "name": "10 User A with 3 rules (200: count 3, active 1, paused 2, newest first, states)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{tokenA}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/dashboards/user/alerts",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "dashboards",
            "user",
            "alerts"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status 200', () => pm.response.to.have.status(200));",
              "const b = pm.response.json();",
              "pm.test('envelope', () => { pm.expect(b.scope).to.eql('CURRENT_USER'); pm.expect(b.status).to.eql('OK'); pm.expect(b.error).to.be.null; pm.expect(b.generatedAt).to.exist; });",
              "pm.test('counts add up', () => pm.expect(b.activeCount + b.pausedCount).to.eql(b.count));",
              "const ids = ['ruleId3', 'ruleId2', 'ruleId1'].map(k => Number(pm.collectionVariables.get(k)));",
              "pm.test('count 3, active 1, paused 2', () => { pm.expect(b.count).to.eql(3); pm.expect(b.activeCount).to.eql(1); pm.expect(b.pausedCount).to.eql(2); });",
              "pm.test('limit 5', () => pm.expect(b.limit).to.eql(5));",
              "pm.test('newest first', () => pm.expect(b.recent.map(r => r.id)).to.eql(ids));",
              "pm.test('each item has summary fields', () => b.recent.forEach(r => ['id', 'name', 'eventType', 'propertyId', 'savedSearchId', 'cadence', 'paused', 'effectivePaused', 'createdAt', 'updatedAt'].forEach(k => pm.expect(r).to.have.property(k))));",
              "pm.test('rule 1: active, watches the active search', () => { const r = b.recent.find(x => x.id === ids[2]); pm.expect(r.eventType).to.eql('NEW_MATCH'); pm.expect(r.savedSearchId).to.eql(Number(pm.collectionVariables.get('ssActiveId'))); pm.expect(r.propertyId).to.be.null; pm.expect(r.paused).to.be.false; pm.expect(r.effectivePaused).to.be.false; });",
              "pm.test('rule 2: paused itself, watches property 4', () => { const r = b.recent.find(x => x.id === ids[1]); pm.expect(r.propertyId).to.eql(4); pm.expect(r.savedSearchId).to.be.null; pm.expect(r.paused).to.be.true; pm.expect(r.effectivePaused).to.be.true; });",
              "pm.test('rule 3: not paused itself but effectively paused by its search', () => { const r = b.recent.find(x => x.id === ids[0]); pm.expect(r.savedSearchId).to.eql(Number(pm.collectionVariables.get('ssPausedId'))); pm.expect(r.paused).to.be.false; pm.expect(r.effectivePaused).to.be.true; });"
            ]
          }
        }
      ]
    },
