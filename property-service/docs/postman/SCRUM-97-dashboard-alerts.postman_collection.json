{
  "info": {
    "name": "SCRUM-97 Dashboard alerts card",
    "description": "Manual checks for GET /api/dashboards/user/alerts. Variables: baseUrl (app), keycloakUrl (realm geozentra), clientId, userA/passwordA and userB/passwordB (two distinct users). Requests 01 and 02 fetch tokens into tokenA/tokenB. Run 03-04 on a user without rules, then 05-09 create two saved searches (one paused) and three alert rules for user A through the existing endpoints (ids stored in ssActiveId, ssPausedId, ruleId1..3; property 4 must exist). 10-15 check counts by effective state, order, bound and ownership, 16-21 clean up and confirm the card is empty again. 22-26 are the error cases.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "01 Token for user A (Keycloak password grant)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/x-www-form-urlencoded"
          }
        ],
        "url": {
          "raw": "{{keycloakUrl}}/protocol/openid-connect/token",
          "host": [
            "{{keycloakUrl}}"
          ],
          "path": [
            "protocol",
            "openid-connect",
            "token"
          ]
        },
        "body": {
          "mode": "urlencoded",
          "urlencoded": [
            {
              "key": "client_id",
              "value": "{{clientId}}"
            },
            {
              "key": "grant_type",
              "value": "password"
            },
            {
              "key": "username",
              "value": "{{userA}}"
            },
            {
              "key": "password",
              "value": "{{passwordA}}"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status 200', () => pm.response.to.have.status(200));",
              "pm.collectionVariables.set('tokenA', pm.response.json().access_token);"
            ]
          }
        }
      ]
    },
