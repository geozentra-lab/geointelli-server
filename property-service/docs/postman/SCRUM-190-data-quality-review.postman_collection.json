{
  "info": {
    "name": "SCRUM-190 Data-quality findings review (admin)",
    "description": "Review and resolution of data-quality findings: access control, reference validation, supported transitions, reasons, history, and the review state shown in the scanner list. Variables: baseUrl, admin_token (Keycloak realm role admin), user_a_token (a user without the role). Run in order; 03 reads the first PROPERTY_MISSING_ADDRESS finding from the scanner (SCRUM-189), so the database must contain at least one property without an address that was never reviewed.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{admin_token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8081"
    },
    {
      "key": "admin_token",
      "value": ""
    },
    {
      "key": "user_a_token",
      "value": ""
    },
    {
      "key": "ref",
      "value": ""
    },
    {
      "key": "adminUserId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "01 Review state without token (401)",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/api/admin/data-quality/issues/PROPERTY_MISSING_ADDRESS:PROPERTY:1",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "admin",
            "data-quality",
            "issues",
            "PROPERTY_MISSING_ADDRESS:PROPERTY:1"
          ]
        },
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "auth": {
          "type": "noauth"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status 401', () => pm.response.to.have.status(401));"
            ]
          }
        }
      ]
    },
    {
      "name": "02 Review state as user A without admin role (403)",
      "request": {
