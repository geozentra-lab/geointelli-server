            "type": "text/javascript",
            "exec": [
              "pm.test('status 200', () => pm.response.to.have.status(200));",
              "const h = pm.response.json().history.map(e => e.fromStatus + '>' + e.toStatus);",
              "pm.test('OPEN > IN_REVIEW > RESOLVED > OPEN', () => pm.expect(h).to.eql(['OPEN>IN_REVIEW', 'IN_REVIEW>RESOLVED', 'RESOLVED>OPEN']));",
              "pm.test('every action has reviewer and time', () => pm.response.json().history.forEach(e => { pm.expect(e.reviewedByUserId).to.be.a('number'); pm.expect(e.reviewedAt).to.be.a('string'); }));"
            ]
          }
        }
      ]
