            "type": "text/javascript",
            "exec": [
              "pm.test('status 200', () => pm.response.to.have.status(200));",
              "const r = pm.response.json();",
              "pm.test('IN_REVIEW by this admin', () => { pm.expect(r.status).to.eql('IN_REVIEW'); pm.expect(r.reviewedByUserId).to.be.a('number'); pm.expect(r.reviewedAt).to.be.a('string'); pm.expect(r.reason).to.eql(null); pm.expect(r.history.length).to.eql(1); pm.expect(r.history[0].fromStatus).to.eql('OPEN'); pm.expect(r.history[0].toStatus).to.eql('IN_REVIEW'); });",
              "pm.collectionVariables.set('adminUserId', r.reviewedByUserId);"
            ]
          }
        }
      ]
    },
