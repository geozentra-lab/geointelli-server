            "type": "text/javascript",
            "exec": [
              "pm.test('status 200', () => pm.response.to.have.status(200));",
              "const r = pm.response.json();",
              "pm.test('RESOLVED, reason kept, history grows', () => { pm.expect(r.status).to.eql('RESOLVED'); pm.expect(r.reason).to.eql('Corrected in the November re-import'); pm.expect(r.reviewedByUserId).to.eql(Number(pm.collectionVariables.get('adminUserId'))); pm.expect(r.history.length).to.eql(2); pm.expect(r.history[1].fromStatus).to.eql('IN_REVIEW'); });"
            ]
          }
        }
      ]
    },
