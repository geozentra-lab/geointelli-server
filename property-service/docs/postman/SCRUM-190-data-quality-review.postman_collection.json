          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status 200', () => pm.response.to.have.status(200));",
              "const i = pm.response.json().issues.content[0];",
              "pm.test('first finding is RESOLVED with reason and reviewer', () => { pm.expect(i.reference).to.eql(pm.collectionVariables.get('ref')); pm.expect(i.reviewStatus).to.eql('RESOLVED'); pm.expect(i.reviewReason).to.eql('Corrected in the November re-import'); pm.expect(i.reviewedByUserId).to.eql(Number(pm.collectionVariables.get('adminUserId'))); pm.expect(i.reviewedAt).to.be.a('string'); });"
            ]
          }
        }
      ]
