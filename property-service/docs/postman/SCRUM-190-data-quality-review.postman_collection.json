              "key": "token",
              "value": "{{user_a_token}}",
              "type": "string"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status 403', () => pm.response.to.have.status(403));"
            ]
          }
        }
      ]
    },
    {
      "name": "03 Scanner list, first missing-address finding (setup, SCRUM-189)",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/api/admin/data-quality/issues?rule=PROPERTY_MISSING_ADDRESS&page=0&size=1",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "admin",
            "data-quality",
            "issues"
          ],
          "query": [
            {
              "key": "rule",
              "value": "PROPERTY_MISSING_ADDRESS"
            },
            {
              "key": "page",
              "value": "0"
            },
            {
              "key": "size",
              "value": "1"
            }
          ]
        },
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "description": "Takes the reference of the first PROPERTY_MISSING_ADDRESS finding as {{ref}}. The finding must not have been reviewed before; otherwise pick another reference or reopen it first."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status 200', () => pm.response.to.have.status(200));",
              "const p = pm.response.json();",
              "pm.test('one finding with a review status', () => { pm.expect(p.issues.content.length).to.eql(1); pm.expect(p.issues.content[0]).to.have.property('reviewStatus'); });",
              "pm.collectionVariables.set('ref', p.issues.content[0].reference);"
            ]
          }
        }
      ]
    },
    {
      "name": "04 Review state of the finding: OPEN, no history",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/api/admin/data-quality/issues/{{ref}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "admin",
            "data-quality",
            "issues",
            "{{ref}}"
          ]
        },
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ]
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status 200', () => pm.response.to.have.status(200));",
              "const r = pm.response.json();",
              "pm.test('OPEN and never reviewed', () => { pm.expect(r.reference).to.eql(pm.collectionVariables.get('ref')); pm.expect(r.status).to.eql('OPEN'); pm.expect(r.rule).to.eql('PROPERTY_MISSING_ADDRESS'); pm.expect(r.entityType).to.eql('PROPERTY'); pm.expect(r.reviewedByUserId).to.eql(null); pm.expect(r.history).to.eql([]); });"
            ]
          }
        }
      ]
    },
