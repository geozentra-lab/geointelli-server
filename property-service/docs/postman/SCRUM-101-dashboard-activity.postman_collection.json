    {
      "name": "10 User A with 5 records (200: 5 created items, one per record, newest first)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{tokenA}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/dashboards/user/activity",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "dashboards",
            "user",
            "activity"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status 200', () => pm.response.to.have.status(200));",
              "const b = pm.response.json();",
              "const v = k => Number(pm.collectionVariables.get(k)); const ssId = v('ssId'), ruleId = v('ruleId'), portfolioId = v('portfolioId'), holdingId = v('holdingId'), propId = v('favPropertyId');",
              "pm.test('envelope', () => { pm.expect(b.scope).to.eql('CURRENT_USER'); pm.expect(b.status).to.eql('OK'); pm.expect(b.error).to.be.null; pm.expect(b.generatedAt).to.exist; });",
              "pm.test('dates are ISO text and newest first', () => { const t = b.recent.map(r => { pm.expect(r.occurredAt).to.be.a('string'); return r.occurredAt; }); for (let i = 1; i < t.length; i++) pm.expect(t[i - 1] >= t[i], t[i - 1] + ' >= ' + t[i]).to.be.true; });",
              "pm.test('each item has the item fields', () => b.recent.forEach(r => ['type', 'occurredAt', 'entityId', 'label', 'propertyId', 'portfolioId'].forEach(k => pm.expect(r).to.have.property(k))));",
              "pm.test('limit 5, 5 items', () => { pm.expect(b.limit).to.eql(5); pm.expect(b.recent.length).to.eql(5); });",
              "pm.test('order: holding, portfolio, alert, search, favorite', () => pm.expect(b.recent.map(r => r.type)).to.eql(['HOLDING_ADDED', 'PORTFOLIO_CREATED', 'ALERT_RULE_CREATED', 'SAVED_SEARCH_CREATED', 'FAVORITE_ADDED']));",
              "pm.test('favorite item: property id as label, no portfolio', () => { const r = b.recent.find(x => x.type === 'FAVORITE_ADDED'); pm.expect(r.propertyId).to.eql(propId); pm.expect(r.label).to.eql('property ' + propId); pm.expect(r.portfolioId).to.be.null; });",
              "pm.test('search item: SAVED_SEARCH_CREATED with its name', () => { const r = b.recent.find(x => x.type === 'SAVED_SEARCH_CREATED'); pm.expect(r.entityId).to.eql(ssId); pm.expect(r.label).to.eql('Miami homes'); pm.expect(r.propertyId).to.be.null; });",
              "pm.test('holding item: HOLDING_ADDED, property and portfolio filled, label names both', () => { const r = b.recent.find(x => x.type === 'HOLDING_ADDED'); pm.expect(r.entityId).to.eql(holdingId); pm.expect(r.propertyId).to.eql(propId); pm.expect(r.portfolioId).to.eql(portfolioId); pm.expect(r.label).to.eql('property ' + propId + ' in Activity card test'); });",
              "pm.test('portfolio item: PORTFOLIO_CREATED, name as label, no property', () => { const r = b.recent.find(x => x.type === 'PORTFOLIO_CREATED'); pm.expect(r.entityId).to.eql(portfolioId); pm.expect(r.label).to.eql('Activity card test'); pm.expect(r.propertyId).to.be.null; pm.expect(r.portfolioId).to.be.null; });",
              "pm.test('alert item: ALERT_RULE_CREATED on a saved search, no property', () => { const r = b.recent.find(x => x.type === 'ALERT_RULE_CREATED'); pm.expect(r.entityId).to.eql(ruleId); pm.expect(r.label).to.eql('New Miami matches'); pm.expect(r.propertyId).to.be.null; });",
              "pm.test('no updated items yet', () => pm.expect(b.recent.filter(r => r.type.endsWith('_UPDATED'))).to.be.empty);"
            ]
          }
        }
      ]
    },
