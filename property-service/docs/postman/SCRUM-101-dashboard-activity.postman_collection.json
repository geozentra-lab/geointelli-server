{
  "info": {
    "name": "SCRUM-101 Dashboard recent-activity card",
    "description": "Manual checks for GET /api/dashboards/user/activity. Variables: baseUrl (app), keycloakUrl (realm geozentra), clientId, userA/passwordA and userB/passwordB (two distinct users), favPropertyId (an existing property, default 4). Requests 01 and 02 fetch tokens into tokenA/tokenB. Run 03-04 on a user without records, then 05-09 create one record of each kind for user A through the existing endpoints (ids stored in ssId, ruleId, portfolioId, holdingId). 10 checks the five created items, 11-12 rename the search and check the updated item, 13-15 check the bound, 16-17 ownership, 18-22 clean up and confirm the card is empty again. 23-27 are the error cases.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "01 Token for user A (Keycloak password grant)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/x-www-form-urlencoded"
          }
        ],
        "url": {
          "raw": "{{keycloakUrl}}/protocol/openid-connect/token",
          "host": [
            "{{keycloakUrl}}"
          ],
          "path": [
            "protocol",
            "openid-connect",
            "token"
          ]
        },
        "body": {
          "mode": "urlencoded",
          "urlencoded": [
            {
              "key": "client_id",
              "value": "{{clientId}}"
            },
            {
              "key": "grant_type",
              "value": "password"
            },
            {
              "key": "username",
              "value": "{{userA}}"
            },
            {
              "key": "password",
              "value": "{{passwordA}}"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status 200', () => pm.response.to.have.status(200));",
              "pm.collectionVariables.set('tokenA', pm.response.json().access_token);"
            ]
          }
        }
      ]
    },
