    {
      "name": "12 User A after the rename (200: SAVED_SEARCH_UPDATED first, created item kept with the new name)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{tokenA}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/dashboards/user/activity",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "dashboards",
            "user",
            "activity"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status 200', () => pm.response.to.have.status(200));",
              "const b = pm.response.json();",
              "const v = k => Number(pm.collectionVariables.get(k)); const ssId = v('ssId'), ruleId = v('ruleId'), portfolioId = v('portfolioId'), holdingId = v('holdingId'), propId = v('favPropertyId');",
              "pm.test('envelope', () => { pm.expect(b.scope).to.eql('CURRENT_USER'); pm.expect(b.status).to.eql('OK'); pm.expect(b.error).to.be.null; pm.expect(b.generatedAt).to.exist; });",
              "pm.test('dates are ISO text and newest first', () => { const t = b.recent.map(r => { pm.expect(r.occurredAt).to.be.a('string'); return r.occurredAt; }); for (let i = 1; i < t.length; i++) pm.expect(t[i - 1] >= t[i], t[i - 1] + ' >= ' + t[i]).to.be.true; });",
              "pm.test('each item has the item fields', () => b.recent.forEach(r => ['type', 'occurredAt', 'entityId', 'label', 'propertyId', 'portfolioId'].forEach(k => pm.expect(r).to.have.property(k))));",
              "pm.test('still 5 items (the favorite is pushed out)', () => pm.expect(b.recent.length).to.eql(5));",
              "pm.test('newest item is the rename', () => { const r = b.recent[0]; pm.expect(r.type).to.eql('SAVED_SEARCH_UPDATED'); pm.expect(r.entityId).to.eql(ssId); pm.expect(r.label).to.eql('Miami homes (renamed)'); });",
              "pm.test('order after the rename', () => pm.expect(b.recent.map(r => r.type)).to.eql(['SAVED_SEARCH_UPDATED', 'HOLDING_ADDED', 'PORTFOLIO_CREATED', 'ALERT_RULE_CREATED', 'SAVED_SEARCH_CREATED']));",
              "pm.test('created item of the search still exists, same id, current name', () => { const r = b.recent.find(x => x.type === 'SAVED_SEARCH_CREATED'); pm.expect(r.entityId).to.eql(ssId); pm.expect(r.label).to.eql('Miami homes (renamed)'); });",
              "pm.test('created item is older than the updated item', () => { const c = b.recent.find(x => x.type === 'SAVED_SEARCH_CREATED'), u = b.recent[0]; pm.expect(JSON.stringify(c.occurredAt)).to.not.eql(JSON.stringify(u.occurredAt)); });"
            ]
          }
        }
      ]
    },
