        {
          "name": "Portfolio without holdings: 200 EMPTY",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "const d = pm.response.json();",
                  "pm.test('scope of my portfolio, no error', () => { pm.expect(d.scope).to.eql('PORTFOLIO'); pm.expect(d.portfolioId).to.eql(Number(pm.collectionVariables.get('portfolioId'))); pm.expect(d.error).to.eql(null); pm.expect(d.currency).to.eql('USD'); });",
                  "pm.test('actual and projected are separate sections', () => { pm.expect(d.actual.basis).to.eql('ACTUAL_RECORDED_CASH'); pm.expect(d.projected.basis).to.eql('CONTRACT_RENT_INVESTMENT_CALCULATION'); pm.expect(d.note).to.be.a('string'); });",
                  "pm.test('status EMPTY', () => { pm.expect(d.status).to.eql('EMPTY'); pm.expect(d.totalHoldings).to.eql(0); });",
                  "pm.test('actual: no records, amounts 0, every expense category missing', () => {",
                  "  pm.expect(d.actual.status).to.eql('NO_RECORDS'); pm.expect(d.actual.income).to.eql(0); pm.expect(d.actual.expenses).to.eql(0);",
                  "  pm.expect(d.actual.categories).to.eql([]); pm.expect(d.actual.expenseCategoriesWithoutRecords).to.eql(['REPAIRS', 'MAINTENANCE', 'INSURANCE', 'PROPERTY_TAX', 'HOA', 'UTILITIES', 'MANAGEMENT_FEE', 'MORTGAGE_PAYMENT', 'OTHER_EXPENSE']);",
                  "});",
                  "pm.test('projected unavailable with a reason, nothing invented', () => {",
                  "  pm.expect(d.projected.status).to.eql('UNAVAILABLE'); pm.expect(d.projected.reason).to.eql('No holdings');",
                  "  pm.expect(d.projected.monthlyGrossRent).to.eql(null); pm.expect(d.projected.periodGrossRent).to.eql(null); pm.expect(d.projected.grossYieldPercent).to.eql(null);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{tokenA}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/dashboards/investor/income-expenses-returns?portfolioId={{portfolioId}}&fromMonth=2026-01&toMonth=2026-03",
