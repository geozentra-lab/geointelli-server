    {
      "name": "3. Success",
      "item": [
        {
          "name": "Period 2026-01 to 2026-03: actual and projected over the same 3 months",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "const d = pm.response.json();",
                  "pm.test('scope of my portfolio, no error', () => { pm.expect(d.scope).to.eql('PORTFOLIO'); pm.expect(d.portfolioId).to.eql(Number(pm.collectionVariables.get('portfolioId'))); pm.expect(d.error).to.eql(null); pm.expect(d.currency).to.eql('USD'); });",
                  "pm.test('actual and projected are separate sections', () => { pm.expect(d.actual.basis).to.eql('ACTUAL_RECORDED_CASH'); pm.expect(d.projected.basis).to.eql('CONTRACT_RENT_INVESTMENT_CALCULATION'); pm.expect(d.note).to.be.a('string'); });",
                  "pm.test('status OK with 2 holdings', () => { pm.expect(d.status).to.eql('OK'); pm.expect(d.totalHoldings).to.eql(2); });",
                  "pm.test('period is the 3 requested months', () => pm.expect(d.period).to.eql({ fromMonth: '2026-01', toMonth: '2026-03', fromDate: '2026-01-01', toDate: '2026-03-31', months: 3, timeZone: 'UTC' }));",
                  "pm.test('actual: only records inside the period', () => {",
                  "  pm.expect(d.actual.status).to.eql('RECORDED'); pm.expect(d.actual.income).to.eql(3500); pm.expect(d.actual.expenses).to.eql(300);",
                  "  pm.expect(d.actual.cashFlow).to.eql(3200); pm.expect(d.actual.recordCount).to.eql(3);",
                  "  pm.expect(d.actual.holdingsWithRecords).to.eql(2); pm.expect(d.actual.holdingsWithoutRecords).to.eql(0);",
                  "});",
                  "pm.test('actual: categories and missing costs', () => {",
                  "  pm.expect(d.actual.categories.map(c => c.category)).to.eql(['RENT', 'REPAIRS']);",
                  "  pm.expect(d.actual.expenseCategoriesWithoutRecords).to.not.include('REPAIRS');",
                  "  pm.expect(d.actual.expenseCategoriesWithoutRecords).to.include.members(['INSURANCE', 'PROPERTY_TAX']);",
                  "});",
                  "pm.test('projected: contract rent over the same 3 months and gross yield', () => {",
                  "  pm.expect(d.projected.status).to.eql('AVAILABLE'); pm.expect(d.projected.rentedHoldings).to.eql(2); pm.expect(d.projected.holdingsWithRent).to.eql(2);",
                  "  pm.expect(d.projected.monthlyGrossRent).to.eql(3500); pm.expect(d.projected.annualGrossRent).to.eql(42000);",
                  "  pm.expect(d.projected.periodGrossRent).to.eql(d.projected.monthlyGrossRent * d.period.months);",
                  "  pm.expect(d.projected.grossYieldPercent).to.eql(8.4);",
                  "});",
                  "pm.test('projected: no NOI and missing inputs disclosed', () => {",
                  "  pm.expect(d.projected.netOperatingIncome).to.eql(null);",
                  "  pm.expect(d.projected.missingInputs.join(' ')).to.include('Property tax not provided');",
                  "  pm.expect(d.projected.missingInputs.join(' ')).to.include('Vacancy rate not provided');",
                  "});"
                ]
              }
            }
          ],
