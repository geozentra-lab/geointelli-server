                  "const now = new Date(); const last = new Date(Date.UTC(now.getUTCFullYear(), now.getUTCMonth() - 1, 1));",
                  "const first = new Date(Date.UTC(last.getUTCFullYear(), last.getUTCMonth() - 11, 1));",
                  "const ym = x => x.getUTCFullYear() + '-' + String(x.getUTCMonth() + 1).padStart(2, '0');",
                  "pm.test('12 months ending with the previous month', () => { pm.expect(d.period.months).to.eql(12); pm.expect(d.period.toMonth).to.eql(ym(last)); pm.expect(d.period.fromMonth).to.eql(ym(first)); });",
                  "pm.test('projected rent covers the same 12 months', () => pm.expect(d.projected.periodGrossRent).to.eql(d.projected.monthlyGrossRent * 12));"
                ]
              }
