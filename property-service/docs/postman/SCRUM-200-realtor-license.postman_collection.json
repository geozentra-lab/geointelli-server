    {
      "name": "14 Latest after rejection (prepared by SQL)",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/api/users/me/realtor-license",
          "host": [
            "{{baseUrl}}"
          ],
