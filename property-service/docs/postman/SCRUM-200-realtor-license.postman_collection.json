            "realtor-license"
          ]
        },
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "description": "SCRUM-199 is not implemented yet, so reject A's pending row by hand first, exactly as the admin endpoint will:\n\nUPDATE realtor_license_verifications SET status = 'REJECTED', decision_method = 'MANUAL',\n  reviewed_by_user_id = (SELECT id FROM users WHERE email = '<admin email>'), decided_at = NOW(),\n  registry_source = 'Florida DBPR licensee search', rejection_reason = 'Name does not match the registry'\nWHERE id = <submissionId from 03>;"
      },
