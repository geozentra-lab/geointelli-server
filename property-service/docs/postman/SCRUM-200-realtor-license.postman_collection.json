      ]
    },
    {
      "name": "03 Submit valid license (201)",
      "request": {
        "method": "POST",
        "url": {
          "raw": "{{baseUrl}}/api/users/me/realtor-license",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "users",
            "me",
            "realtor-license"
          ]
        },
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"licenseHolderName\": \"  Jane Doe  \",\n  \"licensingState\": \"fl\",\n  \"licenseNumber\": \" SL3456789 \",\n  \"licenseExpirationDate\": \"2030-03-31\",\n  \"brokerageName\": \"Sunshine Realty LLC\",\n  \"workEmail\": \"jane@sunshine-realty.example\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status 201', () => pm.response.to.have.status(201));",
              "pm.test('Location header', () => pm.expect(pm.response.headers.get('Location')).to.eql('/api/users/me/realtor-license'));",
              "const r = pm.response.json();",
              "pm.test('pending, trimmed, upper-cased state', () => {",
              "  pm.expect(r.status).to.eql('PENDING_REVIEW');",
              "  pm.expect(r.licenseHolderName).to.eql('Jane Doe');",
              "  pm.expect(r.licensingState).to.eql('FL');",
              "  pm.expect(r.licenseNumber).to.eql('SL3456789');",
              "  pm.expect(r.licenseExpirationDate).to.eql('2030-03-31');",
              "  pm.expect(r.rejectionReason).to.eql(null);",
              "  pm.expect(r.decidedAt).to.eql(null);",
              "  pm.expect(r.submittedAt).to.be.a('string');",
              "});",
              "pm.test('no internal fields', () => { pm.expect(r).to.not.have.property('reviewedByUserId'); pm.expect(r).to.not.have.property('registrySource'); pm.expect(r).to.not.have.property('autoCheckResult'); });",
              "pm.collectionVariables.set('submissionId', r.id);"
            ]
          }
        }
      ]
    },
