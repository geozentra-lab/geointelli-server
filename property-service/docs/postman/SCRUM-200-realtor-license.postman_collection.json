{
  "info": {
    "name": "SCRUM-200 Realtor license verification",
    "description": "Manual checks for the applicant side of realtor license verification. Variables: baseUrl (app), access_token (bearer token of user A), access_token_b (bearer token of a second user, for ownership). Run in order: 01-02 before any submission, 03-05 success, 06-11 invalid input and duplicates, 12-13 ownership, then run the SQL in the description of 14 and continue with 14-16 (resubmission after rejection).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{access_token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8081"
    },
    {
      "key": "access_token",
      "value": ""
    },
    {
      "key": "access_token_b",
      "value": ""
    },
    {
      "key": "submissionId",
      "value": ""
    },
    {
      "key": "resubmissionId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "01 Latest before any submission (404)",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/api/users/me/realtor-license",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "users",
            "me",
            "realtor-license"
          ]
        },
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "description": "Run on a user A who never submitted. If A already has rows, delete them first: DELETE FROM realtor_license_verifications WHERE user_id = (SELECT id FROM users WHERE email = '<A>');"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status 404', () => pm.response.to.have.status(404));"
            ]
          }
        }
      ]
    },
