            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "admin",
            "listing-sources",
            "REALTOR_COM",
            "fields"
          ],
          "query": [
            {
              "key": "group",
              "value": "timestamp"
            },
            {
              "key": "availability",
              "value": "available"
            }
          ]
        },
        "description": "Filter words are case-insensitive."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status 200', () => pm.response.to.have.status(200));",
              "const rows = pm.response.json();",
              "pm.test('both filters applied', () => { pm.expect(rows.length).to.be.above(0); rows.forEach(f => { pm.expect(f.fieldGroup).to.eql('TIMESTAMP'); pm.expect(f.availability).to.eql('AVAILABLE'); }); });",
              "pm.test('freshness field present', () => pm.expect(rows.map(f => f.sourceField)).to.include('last_update_date'));"
            ]
          }
        }
      ]
    },
