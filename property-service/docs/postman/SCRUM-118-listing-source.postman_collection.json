    {
      "name": "03 List listing sources (200, REALTOR_COM pending)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{adminToken}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/admin/listing-sources",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "admin",
            "listing-sources"
          ]
        },
        "description": "Seeded by migration V45; nothing has to be imported first."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status 200', () => pm.response.to.have.status(200));",
              "const list = pm.response.json();",
              "pm.test('REALTOR_COM is listed', () => pm.expect(list.map(s => s.code)).to.include('REALTOR_COM'));",
              "const s = list.find(x => x.code === 'REALTOR_COM');",
              "pm.test('awaiting the product owner', () => { pm.expect(s.authorizationStatus).to.eql('PENDING'); pm.expect(s.authorizedAt).to.be.undefined; });",
              "pm.test('refresh method, coverage and identity documented', () => { pm.expect(s.refreshMethod).to.eql('BATCH_PULL'); pm.expect(s.coverage).to.include('Florida'); pm.expect(s.identityFields).to.include('property_id'); });",
              "pm.test('field count without the field list', () => { pm.expect(s.fieldCount).to.be.above(50); pm.expect(s.fields).to.be.undefined; });"
            ]
          }
        }
      ]
    },
    {
      "name": "04 Get REALTOR_COM with its field mapping (200)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{adminToken}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/admin/listing-sources/REALTOR_COM",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "admin",
            "listing-sources",
            "REALTOR_COM"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status 200', () => pm.response.to.have.status(200));",
              "const s = pm.response.json();",
              "pm.test('fields present and counted', () => { pm.expect(s.fields).to.be.an('array').that.is.not.empty; pm.expect(s.fieldCount).to.eql(s.fields.length); });",
              "pm.test('document order', () => { for (let i = 1; i < s.fields.length; i++) pm.expect(s.fields[i].displayOrder).to.be.above(s.fields[i-1].displayOrder); });",
              "pm.test('asking-price rows target asking_* or hoa_* columns only', () => s.fields.filter(f => f.fieldGroup === 'ASKING_PRICE').forEach(f => pm.expect(f.targetColumn).to.match(/^(asking_|hoa_)/)));",
              "pm.test('sale-price rows target last_sold_* columns only', () => { const sale = s.fields.filter(f => f.fieldGroup === 'SALE_PRICE'); pm.expect(sale.length).to.be.above(0); sale.forEach(f => pm.expect(f.targetColumn).to.match(/^last_sold_/)); });",
              "pm.test('no asking column receives a sale field and vice versa', () => { pm.expect(s.fields.find(f => f.sourceField === 'last_sold_price').targetColumn).to.not.include('asking'); pm.expect(s.fields.find(f => f.sourceField === 'list_price').targetColumn).to.eql('asking_price'); });",
              "pm.test('mapped rows have a target column, unmapped rows do not', () => s.fields.forEach(f => { if (['AVAILABLE','PARTIAL'].includes(f.availability)) pm.expect(f.targetColumn, f.sourceField).to.be.a('string'); else pm.expect(f.targetColumn, f.sourceField).to.be.null; }));",
              "pm.test('every row carries the source code', () => s.fields.forEach(f => pm.expect(f.sourceCode).to.eql('REALTOR_COM')));"
            ]
          }
        }
      ]
    },
    {
      "name": "05 Identifier fields (200, property_id and listing_id)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{adminToken}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/admin/listing-sources/REALTOR_COM/fields?group=IDENTIFIER",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "admin",
            "listing-sources",
            "REALTOR_COM",
            "fields"
          ],
          "query": [
            {
              "key": "group",
              "value": "IDENTIFIER"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status 200', () => pm.response.to.have.status(200));",
              "const rows = pm.response.json();",
              "pm.test('only IDENTIFIER rows', () => { pm.expect(rows.length).to.be.above(0); rows.forEach(f => pm.expect(f.fieldGroup).to.eql('IDENTIFIER')); });",
              "const names = rows.map(f => f.sourceField);",
              "pm.test('source ids present', () => { pm.expect(names).to.include('property_id'); pm.expect(names).to.include('listing_id'); pm.expect(names).to.include('source.listing_id'); });",
              "pm.test('property_id is always available', () => pm.expect(rows.find(f => f.sourceField === 'property_id').availability).to.eql('AVAILABLE'));"
            ]
          }
        }
      ]
    },
    {
      "name": "06 Excluded fields (200, financing and marketing text)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{adminToken}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/admin/listing-sources/REALTOR_COM/fields?availability=EXCLUDED",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "admin",
            "listing-sources",
            "REALTOR_COM",
            "fields"
          ],
          "query": [
            {
              "key": "availability",
              "value": "EXCLUDED"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status 200', () => pm.response.to.have.status(200));",
              "const rows = pm.response.json();",
              "pm.test('only EXCLUDED rows, none with a target column', () => { pm.expect(rows.length).to.be.above(0); rows.forEach(f => { pm.expect(f.availability).to.eql('EXCLUDED'); pm.expect(f.targetColumn).to.be.null; }); });",
              "pm.test('financing fields are excluded', () => pm.expect(rows.some(f => /mortgage|financing/i.test(f.sourceField))).to.be.true);",
              "pm.test('broker text is excluded', () => pm.expect(rows.map(f => f.sourceField)).to.include('description.text'));"
            ]
          }
        }
      ]
    },
    {
      "name": "07 Available timestamps (200, last_update_date)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{adminToken}}"
