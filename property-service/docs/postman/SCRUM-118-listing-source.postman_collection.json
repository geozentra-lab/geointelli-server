{
  "info": {
    "_postman_id": "619b55da-1808-561a-ab10-e789edfde2e9",
    "name": "SCRUM-118 Listing source and field mapping",
    "description": "Manual checks for GET /api/admin/listing-sources, /{code} and /{code}/fields. Variables: baseUrl (app), keycloakUrl (realm, e.g. http://localhost:8090/realms/geozentra), clientId, adminUser/adminPassword (realm role admin), user/password (no admin role). 01-02 fetch tokens. 03-08 read the seeded REALTOR_COM source and its mapping with filters (success), 09-11 are the invalid-input cases, 12-13 the ownership checks. Nothing has to be imported: migration V45 seeds the rows.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "01 Token for the admin (Keycloak password grant)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/x-www-form-urlencoded"
          }
        ],
        "url": {
          "raw": "{{keycloakUrl}}/protocol/openid-connect/token",
          "host": [
            "{{keycloakUrl}}"
          ],
          "path": [
            "protocol",
            "openid-connect",
            "token"
          ]
        },
        "body": {
          "mode": "urlencoded",
          "urlencoded": [
            {
              "key": "client_id",
              "value": "{{clientId}}"
            },
            {
              "key": "grant_type",
              "value": "password"
            },
            {
              "key": "username",
              "value": "{{adminUser}}"
            },
            {
              "key": "password",
              "value": "{{adminPassword}}"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status 200', () => pm.response.to.have.status(200));",
              "pm.collectionVariables.set('adminToken', pm.response.json().access_token);"
            ]
          }
        }
      ]
    },
