{
  "info": {
    "name": "SCRUM-96 Dashboard saved-search card",
    "description": "Manual checks for GET /api/dashboards/user/saved-searches. Variables: baseUrl (app), keycloakUrl (realm geozentra), clientId, userA/passwordA and userB/passwordB (two distinct users). Requests 01 and 02 fetch tokens into tokenA/tokenB. Run 03-04 on a user without saved searches, then 05-07 create three saved searches for user A through the existing POST /api/saved-searches (ids are stored in ssId1..ssId3), 08-13 check count, order, bound, monitoring state and ownership, 14-17 clean up and confirm the card is empty again. 18-22 are the error cases.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "01 Token for user A (Keycloak password grant)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/x-www-form-urlencoded"
          }
        ],
        "url": {
          "raw": "{{keycloakUrl}}/protocol/openid-connect/token",
          "host": [
            "{{keycloakUrl}}"
          ],
          "path": [
            "protocol",
            "openid-connect",
            "token"
          ]
        },
        "body": {
          "mode": "urlencoded",
          "urlencoded": [
            {
              "key": "client_id",
              "value": "{{clientId}}"
            },
            {
              "key": "grant_type",
              "value": "password"
            },
            {
              "key": "username",
              "value": "{{userA}}"
            },
            {
              "key": "password",
              "value": "{{passwordA}}"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status 200', () => pm.response.to.have.status(200));",
              "pm.collectionVariables.set('tokenA', pm.response.json().access_token);"
            ]
          }
        }
      ]
    },
