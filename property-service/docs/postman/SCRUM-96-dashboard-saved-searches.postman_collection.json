    {
      "name": "08 User A with 3 saved searches (200, count 3, newest first, monitoring state)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{tokenA}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/dashboards/user/saved-searches",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "dashboards",
            "user",
            "saved-searches"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status 200', () => pm.response.to.have.status(200));",
              "const b = pm.response.json();",
              "pm.test('envelope', () => { pm.expect(b.scope).to.eql('CURRENT_USER'); pm.expect(b.status).to.eql('OK'); pm.expect(b.error).to.be.null; pm.expect(b.generatedAt).to.exist; });",
              "const ids = ['ssId3', 'ssId2', 'ssId1'].map(k => Number(pm.collectionVariables.get(k)));",
              "pm.test('count is the real total', () => pm.expect(b.count).to.eql(3));",
              "pm.test('limit 5', () => pm.expect(b.limit).to.eql(5));",
              "pm.test('newest first', () => pm.expect(b.recent.map(r => r.id)).to.eql(ids));",
              "pm.test('each item has summary fields only', () => b.recent.forEach(r => { ['id', 'name', 'cadence', 'paused', 'createdAt', 'updatedAt'].forEach(k => pm.expect(r).to.have.property(k)); pm.expect(r).to.not.have.property('filters'); }));",
              "pm.test('monitoring state: paused WEEKLY search is reported', () => { const p = b.recent.find(r => r.id === ids[1]); pm.expect(p.cadence).to.eql('WEEKLY'); pm.expect(p.paused).to.be.true; });",
              "pm.test('monitoring state: defaults are DAILY, not paused', () => { const d = b.recent.find(r => r.id === ids[0]); pm.expect(d.cadence).to.eql('DAILY'); pm.expect(d.paused).to.be.false; });"
            ]
          }
        }
      ]
    },
