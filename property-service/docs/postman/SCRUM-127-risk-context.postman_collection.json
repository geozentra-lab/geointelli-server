          "path": [
            "api",
            "properties",
            "id",
            "{{idZoneX}}",
            "location-intelligence",
            "risk"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status 200', () => pm.response.to.have.status(200));",
              "const f = pm.response.json().flood;",
              "pm.test('zone X outside the SFHA', () => { pm.expect(f.status).to.eql('AVAILABLE'); pm.expect(f.zone).to.eql('X'); pm.expect(f.specialFloodHazardArea).to.eql(false); });",
              "pm.test('no base flood elevation invented', () => pm.expect(f.baseFloodElevationFt).to.be.null);"
            ]
          }
        }
      ]
    },
    {
      "name": "03 Open water (200, hazards NO_DATA)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/properties/id/{{idOpenWater}}/location-intelligence/risk",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "properties",
            "id",
            "{{idOpenWater}}",
            "location-intelligence",
            "risk"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status 200', () => pm.response.to.have.status(200));",
              "const r = pm.response.json();",
              "pm.test('flood zone OPEN WATER', () => pm.expect(r.flood.zone).to.eql('OPEN WATER'));",
              "pm.test('water tract has no NRI row and says so', () => { pm.expect(r.hazards.status).to.eql('NO_DATA'); pm.expect(r.hazards.overallRating).to.be.null; pm.expect(r.hazards.note).to.include('no NRI row'); });",
              "pm.test('storms still evaluated', () => pm.expect(r.storms.status).to.be.oneOf(['AVAILABLE', 'NO_DATA']));"
            ]
          }
        }
      ]
    },
    {
