      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status 200', () => pm.response.to.have.status(200));",
              "const r = pm.response.json();",
              "pm.test('flood NO_DATA, not flood-free', () => { pm.expect(r.flood.status).to.eql('NO_DATA'); pm.expect(r.flood.zone).to.be.null; pm.expect(r.flood.specialFloodHazardArea).to.be.null; pm.expect(r.flood.note).to.include('not a flood-free determination'); });",
              "pm.test('other blocks unaffected', () => { pm.expect(r.hazards.status).to.not.eql('UNAVAILABLE'); pm.expect(r.storms.status).to.eql('AVAILABLE'); });"
            ]
          }
        }
      ]
    },
