              "pm.test('zero within radius, county count kept', () => { pm.expect(s.status).to.eql('NO_DATA'); pm.expect(s.eventsWithinRadius).to.eql(0); pm.expect(s.byType).to.be.empty; pm.expect(s.eventsInCounty).to.be.above(0); pm.expect(s.note).to.include('county-level events may still exist'); });"
            ]
          }
