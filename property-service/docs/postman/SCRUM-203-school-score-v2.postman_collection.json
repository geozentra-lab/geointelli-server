        {
          "name": "2.3 School context: a school not graded by FLDOE",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "const c = pm.response.json();",
                  "pm.test('assigned schools: one per level, elementary first', () => pm.expect(c.assignedSchools.map(s => s.level)).to.eql(['ELEMENTARY', 'MIDDLE', 'HIGH']));",
                  "pm.test('score v2 between 0 and 100 with its label', () => { pm.expect(c.schoolScoreV2).to.be.within(0, 100); pm.expect(c.schoolScoreV2Label).to.be.oneOf(['Excellent', 'Good', 'Fair', 'Limited']); pm.expect(c.scoreVersion).to.eql(2); });",
                  "pm.test('v2 source names the FLDOE year', () => pm.expect(c.source).to.include('FLDOE School Grades ' + c.gradeYear));",
                  "const ungraded = c.assignedSchools.filter(s => s.letterGrade === null);",
                  "pm.test('the ungraded school has no grade value and a note, never a low grade', () => { pm.expect(ungraded.length).to.be.above(0); ungraded.forEach(s => { pm.expect(s.statewidePercentile).to.eql(null); pm.expect(s.note).to.include('Not graded by FLDOE'); }); });",
                  "pm.test('quality still known from the graded levels', () => pm.expect(c.qualityScore).to.be.within(0, 100));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/properties/id/{{ungradedProperty}}/location-intelligence/schools",
              "host": [
