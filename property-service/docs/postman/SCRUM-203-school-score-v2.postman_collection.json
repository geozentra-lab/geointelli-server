                "location-intelligence",
                "schools"
              ]
            }
          }
        },
        {
          "name": "2.5 Bulk school analysis: v2 fields, unknown property absent",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "const map = pm.response.json();",
                  "const id = pm.collectionVariables.get('zonedProperty');",
                  "pm.test('the property has its assigned schools and score v2', () => { pm.expect(map[id].assignedSchools.length).to.eql(3); pm.expect(map[id].schoolScoreV2).to.be.within(0, 100); pm.expect(map[id].gradeYear).to.be.above(2000); });",
                  "pm.test('an unknown property is not in the result', () => pm.expect(Object.keys(map)).to.not.include('999999999'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{baseUrl}}/api/property-school-analysis/bulk",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "property-school-analysis",
                "bulk"
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"propertyIds\": [{{zonedProperty}}, {{nearestProperty}}, 999999999]\n}"
            }
          }
        }
      ]
    },
