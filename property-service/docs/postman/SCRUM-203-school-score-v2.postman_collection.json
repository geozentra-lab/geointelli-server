          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/ingestion/jobs/{{jobId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "ingestion",
                "jobs",
                "{{jobId}}"
              ]
            }
          }
        },
        {
          "name": "1.6 Admin listing of school scoring jobs",
          "event": [
            {
              "listen": "test",
