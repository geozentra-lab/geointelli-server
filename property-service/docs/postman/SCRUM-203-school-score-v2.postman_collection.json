        },
        {
          "name": "2.4 School context: the zoned school is not in the school data",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "const c = pm.response.json();",
                  "const elementary = c.assignedSchools.find(s => s.level === 'ELEMENTARY');",
                  "pm.test('the level names the zone\\'s school, has no school, no grade, no distance', () => { pm.expect(elementary.assignmentMethod).to.eql('UNMATCHED_ZONE'); pm.expect(elementary.schoolId).to.eql(null); pm.expect(elementary.name).to.be.a('string'); pm.expect(elementary.distanceMeters).to.eql(null); pm.expect(elementary.statewidePercentile).to.eql(null); pm.expect(elementary.note).to.include('not in the school data'); });",
                  "pm.test('the score uses the other levels only', () => { pm.expect(c.schoolScoreV2).to.be.within(0, 100); pm.expect(c.note).to.include('left out of the score'); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/properties/id/{{unmatchedProperty}}/location-intelligence/schools",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "properties",
