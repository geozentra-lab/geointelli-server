                  "const job = pm.response.json();",
                  "pm.test('school scoring job', () => { pm.expect(job.jobType).to.eql('SCHOOL_SCORING'); pm.expect(job.dataset).to.eql('SCHOOL_SCORE_V2'); pm.expect(job.status).to.be.oneOf(['QUEUED', 'RUNNING']); pm.expect(job.inputStorage).to.eql('NONE'); });",
                  "pm.test('Location points at the job', () => pm.expect(pm.response.headers.get('Location')).to.eql('/api/ingestion/jobs/' + job.id));",
                  "pm.collectionVariables.set('jobId', job.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{baseUrl}}/api/property-school-analysis/calculate-all?version=2&fips5={{fips5}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
