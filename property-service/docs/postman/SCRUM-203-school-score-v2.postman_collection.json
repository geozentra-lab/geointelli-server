    {
      "name": "2 Reading the result",
      "item": [
        {
          "name": "2.1 School context: zoned and graded schools",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "const c = pm.response.json();",
                  "pm.test('assigned schools: one per level, elementary first', () => pm.expect(c.assignedSchools.map(s => s.level)).to.eql(['ELEMENTARY', 'MIDDLE', 'HIGH']));",
                  "pm.test('score v2 between 0 and 100 with its label', () => { pm.expect(c.schoolScoreV2).to.be.within(0, 100); pm.expect(c.schoolScoreV2Label).to.be.oneOf(['Excellent', 'Good', 'Fair', 'Limited']); pm.expect(c.scoreVersion).to.eql(2); });",
                  "pm.test('v2 source names the FLDOE year', () => pm.expect(c.source).to.include('FLDOE School Grades ' + c.gradeYear));",
                  "pm.test('AVAILABLE, every level by its zone', () => { pm.expect(c.status).to.eql('AVAILABLE'); c.assignedSchools.forEach(s => { pm.expect(s.assignmentMethod).to.eql('ZONE'); pm.expect(s.zoneSourceType).to.be.a('string'); pm.expect(s.distanceMeters).to.be.above(0); }); });",
                  "pm.test('quality, access and choice are known', () => { pm.expect(c.qualityScore).to.be.within(0, 100); pm.expect(c.accessScore).to.be.within(0, 100); pm.expect(c.choiceScore).to.be.within(0, 100); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/properties/id/{{zonedProperty}}/location-intelligence/schools",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "properties",
                "id",
                "{{zonedProperty}}",
                "location-intelligence",
                "schools"
              ]
            }
          }
        },
        {
          "name": "2.2 School context: no zone covers the property (nearest schools)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "const c = pm.response.json();",
                  "pm.test('assigned schools: one per level, elementary first', () => pm.expect(c.assignedSchools.map(s => s.level)).to.eql(['ELEMENTARY', 'MIDDLE', 'HIGH']));",
                  "pm.test('score v2 between 0 and 100 with its label', () => { pm.expect(c.schoolScoreV2).to.be.within(0, 100); pm.expect(c.schoolScoreV2Label).to.be.oneOf(['Excellent', 'Good', 'Fair', 'Limited']); pm.expect(c.scoreVersion).to.eql(2); });",
                  "pm.test('v2 source names the FLDOE year', () => pm.expect(c.source).to.include('FLDOE School Grades ' + c.gradeYear));",
                  "pm.test('NEAREST schools have no zone and say so', () => c.assignedSchools.forEach(s => { pm.expect(s.assignmentMethod).to.eql('NEAREST'); pm.expect(s.zoneSourceType).to.eql(null); pm.expect(s.note).to.include('No attendance zone'); }));",
                  "pm.test('the section note names the levels', () => pm.expect(c.note).to.include('no attendance zone covers this property for'));"
                ]
              }
