                "property-school-analysis",
                "calculate-all"
              ],
              "query": [
                {
                  "key": "version",
                  "value": "2"
                },
                {
                  "key": "fips5",
                  "value": "{{fips5}}"
                }
              ]
            }
          }
        },
        {
          "name": "1.5 Job status (poll until COMPLETED)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "const job = pm.response.json();",
                  "pm.test('counters add up', () => pm.expect(job.processed).to.eql(job.completed + job.skipped + job.failed));",
                  "if (job.status === 'COMPLETED') {",
                  "  pm.test('every property handled, none failed', () => { pm.expect(job.processed).to.eql(job.total); pm.expect(job.failed).to.eql(0); pm.expect(job.total).to.be.above(0); });",
                  "  pm.test('step reports the scored properties and the FLDOE year', () => pm.expect(job.currentStep).to.include('scored'));",
                  "} else { pm.test('job still running or queued', () => pm.expect(job.status).to.be.oneOf(['QUEUED', 'RUNNING'])); console.log('job is ' + job.status + ', send again'); }"
                ]
              }
