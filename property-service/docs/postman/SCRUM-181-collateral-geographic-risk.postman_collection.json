    {
      "name": "2. Success",
      "item": [
        {
          "name": "Every source covers the property: 200, geography AVAILABLE",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "const d = pm.response.json();",
                  "const g = d.geography;",
                  "pm.test('disclaimer, LTV and geography sections', () => { pm.expect(d.disclaimer).to.be.a('string'); pm.expect(d.ltv).to.be.an('object'); pm.expect(g).to.be.an('object'); });",
                  "pm.test('no risk score added by GeoZentra', () => { pm.expect(g).to.not.have.property('score'); pm.expect(d).to.not.have.property('riskScore'); });",
                  "pm.test('three sources in order, each with its provider name', () => { pm.expect(g.sources.map(s => s.section)).to.eql(['FLOOD', 'HAZARDS', 'STORMS']); g.sources.forEach(s => pm.expect(s.source, s.section).to.be.a('string')); });",
                  "pm.test('missingCoverage lists exactly the NO_COVERAGE / UNAVAILABLE sources', () => pm.expect(g.missingCoverage).to.eql(g.sources.filter(s => ['NO_COVERAGE', 'UNAVAILABLE'].includes(s.status)).map(s => s.section)));",
                  "pm.test('location of the collateral', () => pm.expect(g.location.folio).to.be.a('string'));",
                  "pm.test('SCRUM-127 risk context included unchanged', () => pm.expect(g.riskContext.propertyId).to.eql(d.propertyId));",
                  "pm.test('status AVAILABLE, no reason, nothing missing', () => { pm.expect(g.status).to.eql('AVAILABLE'); pm.expect(g.reasons).to.eql([]); pm.expect(g.missingCoverage).to.eql([]); });",
                  "pm.test('every source has a data date', () => g.sources.forEach(s => pm.expect(s.dataAsOf, s.section).to.be.a('string')));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{tokenA}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/lender/applications/{{appFull}}/collateral-analysis?organizationId={{organizationId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "lender",
                "applications",
                "{{appFull}}",
                "collateral-analysis"
              ],
              "query": [
                {
                  "key": "organizationId",
                  "value": "{{organizationId}}"
                }
              ]
            }
          }
        },
        {
          "name": "One source does not cover the property: 200, geography PARTIAL, valuation and LTV still there",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "const d = pm.response.json();",
                  "const g = d.geography;",
                  "pm.test('disclaimer, LTV and geography sections', () => { pm.expect(d.disclaimer).to.be.a('string'); pm.expect(d.ltv).to.be.an('object'); pm.expect(g).to.be.an('object'); });",
                  "pm.test('no risk score added by GeoZentra', () => { pm.expect(g).to.not.have.property('score'); pm.expect(d).to.not.have.property('riskScore'); });",
                  "pm.test('three sources in order, each with its provider name', () => { pm.expect(g.sources.map(s => s.section)).to.eql(['FLOOD', 'HAZARDS', 'STORMS']); g.sources.forEach(s => pm.expect(s.source, s.section).to.be.a('string')); });",
                  "pm.test('missingCoverage lists exactly the NO_COVERAGE / UNAVAILABLE sources', () => pm.expect(g.missingCoverage).to.eql(g.sources.filter(s => ['NO_COVERAGE', 'UNAVAILABLE'].includes(s.status)).map(s => s.section)));",
                  "pm.test('location of the collateral', () => pm.expect(g.location.folio).to.be.a('string'));",
                  "pm.test('SCRUM-127 risk context included unchanged', () => pm.expect(g.riskContext.propertyId).to.eql(d.propertyId));",
                  "pm.test('status PARTIAL', () => pm.expect(g.status).to.eql('PARTIAL'));",
                  "pm.test('FLOOD listed as missing, the others kept', () => { pm.expect(g.missingCoverage).to.include('FLOOD'); pm.expect(g.missingCoverage.length).to.be.below(3); });",
                  "pm.test('missing source keeps its explanation', () => pm.expect(g.sources.find(s => s.section === 'FLOOD').note).to.be.a('string'));",
                  "pm.test('LTV section not hidden by the missing source', () => pm.expect(d.ltv.status).to.be.oneOf(['AVAILABLE', 'LIMITED', 'UNAVAILABLE']));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{tokenA}}"
              }
            ],
