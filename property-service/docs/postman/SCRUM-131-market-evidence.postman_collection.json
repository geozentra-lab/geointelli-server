    {
      "name": "03 Empty market: ZIP 33139 before any import (200, no rows)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{userToken}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/market-evidence?level=ZIP&code=33139",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "market-evidence"
          ],
          "query": [
            {
              "key": "level",
              "value": "ZIP"
            },
            {
              "key": "code",
              "value": "33139"
            }
          ]
        },
        "description": "Run on a database with no SAMPLE_PROVIDER rows: totalElements is 0. On a reused database it records the current count for the idempotency check."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status 200', () => pm.response.to.have.status(200));",
              "const page = pm.response.json();",
              "pm.test('empty page, not 404', () => { pm.expect(page.content).to.be.an('array'); pm.expect(page.totalElements).to.be.a('number'); });",
              "pm.collectionVariables.set('rowsBefore', page.totalElements);"
            ]
          }
        }
      ]
    },
    {
      "name": "04 Admin imports market_evidence.csv (202, job queued)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{adminToken}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/admin/market-evidence/import",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "admin",
            "market-evidence",
            "import"
          ]
        },
        "body": {
          "mode": "formdata",
          "formdata": [
            {
              "key": "file",
              "type": "file",
              "src": "{{sampleDir}}/market_evidence.csv"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status 202', () => pm.response.to.have.status(202));",
              "pm.test('Location points at the job', () => pm.expect(pm.response.headers.get('Location')).to.include('/api/ingestion/jobs/'));",
              "const job = pm.response.json();",
              "pm.test('job queued for MARKET_EVIDENCE', () => { pm.expect(job.dataset).to.eql('MARKET_EVIDENCE'); pm.expect(job.jobType).to.eql('CSV_IMPORT'); pm.expect(['QUEUED','RUNNING','COMPLETED']).to.include(job.status); });",
              "pm.collectionVariables.set('jobId', job.id);"
            ]
          }
        }
      ]
    },
    {
      "name": "05 Poll the job (200, COMPLETED, 6 rows)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{adminToken}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/ingestion/jobs/{{jobId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "ingestion",
            "jobs",
            "{{jobId}}"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status 200', () => pm.response.to.have.status(200));",
              "const job = pm.response.json();",
              "if (job.status === 'QUEUED' || job.status === 'RUNNING') { console.log('still ' + job.status + ', send this request again'); }",
              "pm.test('job is COMPLETED (re-send while QUEUED/RUNNING)', () => pm.expect(job.status).to.eql('COMPLETED'));",
              "pm.test('6 rows completed, none failed', () => { pm.expect(job.total).to.eql(6); pm.expect(job.completed).to.eql(6); pm.expect(job.failed).to.eql(0); });"
            ]
          }
        }
      ]
    },
    {
      "name": "06 Read ZIP 33139 (200, sale and asking rows kept apart)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{userToken}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/market-evidence?level=ZIP&code=33139",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "market-evidence"
          ],
          "query": [
            {
              "key": "level",
              "value": "ZIP"
            },
            {
              "key": "code",
              "value": "33139"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status 200', () => pm.response.to.have.status(200));",
              "const page = pm.response.json();",
              "pm.test('the 4 sample ZIP rows are there', () => pm.expect(page.content.filter(o => o.source === 'SAMPLE_PROVIDER').length).to.eql(4));",
              "pm.test('newest period first', () => pm.expect(page.content[0].periodStart).to.eql('2026-10-01'));",
              "pm.test('SALE rows have no asking figures', () => page.content.filter(o => o.evidenceType === 'SALE').forEach(o => { pm.expect(o.saleCount).to.not.be.null; pm.expect(o.medianAskingPrice).to.be.null; pm.expect(o.activeListingCount).to.be.null; }));",
              "pm.test('ASKING rows have no sale figures', () => page.content.filter(o => o.evidenceType === 'ASKING').forEach(o => { pm.expect(o.activeListingCount).to.not.be.null; pm.expect(o.medianSalePrice).to.be.null; pm.expect(o.saleCount).to.be.null; }));",
              "pm.test('provenance and freshness present', () => page.content.forEach(o => { pm.expect(o.source).to.eql('SAMPLE_PROVIDER'); pm.expect(o.importedAt).to.be.a('string'); pm.expect(o.importJobId).to.be.a('string'); pm.expect(o.sourceReleaseDate).to.be.a('string'); }));",
              "pm.test('state linked', () => page.content.forEach(o => pm.expect(o.stateId).to.be.a('number')));",
              "pm.collectionVariables.set('rowsAfterFirstImport', page.totalElements);"
            ]
          }
        }
      ]
    },
