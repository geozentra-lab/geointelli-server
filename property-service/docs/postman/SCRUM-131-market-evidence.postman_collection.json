{
  "info": {
    "_postman_id": "e20358ee-9a0d-5522-90a9-4b84add837ca",
    "name": "SCRUM-131 Market evidence ingestion",
    "description": "Manual checks for POST /api/admin/market-evidence/import and GET /api/market-evidence. Variables: baseUrl (app), keycloakUrl (realm, e.g. http://localhost:8090/realms/geozentra), clientId, adminUser/adminPassword (realm role admin), user/password (no admin role), sampleDir (absolute path of docs/postman/samples/market-evidence). 01-02 fetch tokens. 03 reads the empty market, 04-08 import the six-row sample and read it, 09-11 import it again and check the row count did not change, 12-17 are the invalid-input and invalid-row cases (poll requests must be re-sent while the job is QUEUED or RUNNING), 18-20 invalid reads, 21-23 ownership and the refused generic endpoint.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "01 Token for the admin (Keycloak password grant)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/x-www-form-urlencoded"
          }
        ],
        "url": {
          "raw": "{{keycloakUrl}}/protocol/openid-connect/token",
          "host": [
            "{{keycloakUrl}}"
          ],
          "path": [
            "protocol",
            "openid-connect",
            "token"
          ]
        },
        "body": {
          "mode": "urlencoded",
          "urlencoded": [
            {
              "key": "client_id",
              "value": "{{clientId}}"
            },
            {
              "key": "grant_type",
              "value": "password"
            },
            {
              "key": "username",
              "value": "{{adminUser}}"
            },
            {
              "key": "password",
              "value": "{{adminPassword}}"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status 200', () => pm.response.to.have.status(200));",
              "pm.collectionVariables.set('adminToken', pm.response.json().access_token);"
            ]
          }
        }
      ]
    },
    {
      "name": "02 Token for a non-admin user",
