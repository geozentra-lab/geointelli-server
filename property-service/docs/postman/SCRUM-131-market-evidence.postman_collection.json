              "pm.test('INVALID_ROW naming sale_count on record 2 (data rows count from 1)', () => { pm.expect(job.errorCode).to.eql('INVALID_ROW'); pm.expect(job.errorMessage).to.include('market_evidence.csv:2'); pm.expect(job.errorMessage).to.include('sale_count'); });",
