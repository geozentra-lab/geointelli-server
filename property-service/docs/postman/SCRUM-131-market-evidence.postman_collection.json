              "if (job.status === 'QUEUED' || job.status === 'RUNNING') { console.log('still ' + job.status + ', send this request again'); }",
              "pm.test('job is FAILED (re-send while QUEUED/RUNNING)', () => pm.expect(job.status).to.eql('FAILED'));",
              "pm.test('sale and asking never mix', () => { pm.expect(job.errorCode).to.eql('INVALID_ROW'); pm.expect(job.errorMessage).to.include('median_asking_price'); pm.expect(job.errorMessage).to.include('must be empty'); });"
