    {
      "name": "03 User A submits a license (setup, SCRUM-200)",
      "request": {
        "method": "POST",
        "url": {
          "raw": "{{baseUrl}}/api/users/me/realtor-license",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "users",
            "me",
            "realtor-license"
          ]
        },
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"licenseHolderName\": \"Jane Doe\",\n  \"licensingState\": \"FL\",\n  \"licenseNumber\": \"SL3456789\",\n  \"licenseExpirationDate\": \"2030-03-31\",\n  \"brokerageName\": \"Sunshine Realty LLC\",\n  \"workEmail\": \"jane@sunshine-realty.example\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{user_a_token}}",
              "type": "string"
            }
          ]
        },
        "description": "Creates the pending row the admin decides on. User A must have no pending or verified submission; otherwise delete A's rows first: DELETE FROM realtor_license_verifications WHERE user_id = (SELECT id FROM users WHERE email = '<A>');"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status 201', () => pm.response.to.have.status(201));",
              "pm.collectionVariables.set('submissionA', pm.response.json().id);"
            ]
          }
        }
      ]
    },
    {
      "name": "04 Admin lists pending submissions",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/api/admin/realtor-license-verifications?status=PENDING_REVIEW&page=0&size=20",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "admin",
            "realtor-license-verifications"
          ],
          "query": [
            {
              "key": "status",
              "value": "PENDING_REVIEW"
            },
            {
              "key": "page",
              "value": "0"
            },
            {
              "key": "size",
              "value": "20"
            }
          ]
        },
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ]
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status 200', () => pm.response.to.have.status(200));",
              "const p = pm.response.json();",
              "pm.test('page shape', () => { pm.expect(p).to.have.property('content'); pm.expect(p).to.have.property('totalElements'); });",
              "const row = p.content.find(r => r.id === Number(pm.collectionVariables.get('submissionA')));",
              "pm.test('contains submission A with applicant', () => { pm.expect(row).to.not.be.undefined; pm.expect(row.status).to.eql('PENDING_REVIEW'); pm.expect(row.applicantUserId).to.be.a('number'); pm.expect(row).to.have.property('applicantEmail'); });",
              "pm.test('newest first', () => { const ids = p.content.map(r => r.id); pm.expect(ids).to.eql([...ids].sort((a, b) => b - a)); });"
            ]
          }
        }
      ]
    },
    {
      "name": "05 Admin reads submission A",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/api/admin/realtor-license-verifications/{{submissionA}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
