      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status 200', () => pm.response.to.have.status(200));",
              "const r = pm.response.json();",
              "pm.test('pending, nothing decided yet', () => { pm.expect(r.status).to.eql('PENDING_REVIEW'); pm.expect(r.decisionMethod).to.eql(null); pm.expect(r.reviewedByUserId).to.eql(null); pm.expect(r.decidedAt).to.eql(null); pm.expect(r.registrySource).to.eql(null); pm.expect(r.rejectionReason).to.eql(null); });",
              "pm.test('submitted details present', () => { pm.expect(r.licenseHolderName).to.eql('Jane Doe'); pm.expect(r.licenseNumber).to.eql('SL3456789'); pm.expect(r.submittedAt).to.be.a('string'); });"
            ]
          }
        }
      ]
    },
