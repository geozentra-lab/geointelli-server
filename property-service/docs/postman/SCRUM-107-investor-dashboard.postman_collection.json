    {
      "name": "3. Success",
      "item": [
        {
          "name": "Period 2026-01 to 2026-03: the four cards of my portfolio",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "const d = pm.response.json();",
                  "const cards = [d.valueEquityDebt, d.incomeExpensesReturns, d.occupancyExposure, d.opportunities];",
                  "pm.test('scope of my portfolio', () => { pm.expect(d.scope).to.eql('PORTFOLIO'); pm.expect(d.portfolioId).to.eql(Number(pm.collectionVariables.get('portfolioId'))); pm.expect(d.portfolioCount).to.eql(1); });",
                  "pm.test('four cards, all loaded, same scope', () => {",
                  "  pm.expect(d.failedCards).to.eql([]);",
                  "  cards.forEach(c => { pm.expect(c).to.be.an('object'); pm.expect(c.status).to.be.oneOf(['OK', 'EMPTY']); pm.expect(c.error).to.eql(null); pm.expect(c.scope).to.eql(d.scope); pm.expect(c.portfolioId).to.eql(d.portfolioId); });",
                  "});",
                  "pm.test('income card uses the dashboard period', () => pm.expect(d.incomeExpensesReturns.period).to.eql(d.period));",
                  "pm.test('opportunities: items are flagged alreadyHeld', () => d.opportunities.items.forEach(i => pm.expect(i.alreadyHeld).to.be.a('boolean')));",
                  "pm.test('note', () => pm.expect(d.note).to.be.a('string'));",
                  "pm.test('status OK', () => pm.expect(d.status).to.eql('OK'));",
                  "pm.test('period is the 3 requested months', () => pm.expect(d.period).to.eql({ fromMonth: '2026-01', toMonth: '2026-03', fromDate: '2026-01-01', toDate: '2026-03-31', months: 3, timeZone: 'UTC' }));",
                  "pm.test('value and occupancy cards see the 2 holdings', () => {",
                  "  pm.expect(d.valueEquityDebt.status).to.eql('OK'); pm.expect(d.valueEquityDebt.totalHoldings).to.eql(2);",
                  "  pm.expect(d.occupancyExposure.status).to.eql('OK'); pm.expect(d.occupancyExposure.totalHoldings).to.eql(2); pm.expect(d.occupancyExposure.occupancyCounts.RENTED).to.eql(2);",
                  "});",
                  "pm.test('income card: recorded cash of the period, projection kept apart', () => {",
                  "  const c = d.incomeExpensesReturns; pm.expect(c.status).to.eql('OK');",
                  "  pm.expect(c.actual.income).to.eql(3500); pm.expect(c.actual.expenses).to.eql(300); pm.expect(c.actual.cashFlow).to.eql(3200);",
                  "  pm.expect(c.projected.status).to.eql('AVAILABLE'); pm.expect(c.projected.monthlyGrossRent).to.eql(3500);",
                  "});"
                ]
              }
            }
          ],
