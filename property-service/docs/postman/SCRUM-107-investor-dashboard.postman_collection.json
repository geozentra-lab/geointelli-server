{
  "info": {
    "name": "SCRUM-107 Investor dashboard: composed GET /api/dashboards/investor",
    "description": "Manual checks for GET /api/dashboards/investor. See docs/investor-dashboard.md. Run the folders in order with the Collection Runner. Needs a running service (baseUrl), a Keycloak realm (keycloakUrl, clientIdKc), two users (A owns the data, B is another investor; both must have logged in to GeoZentra once) and two existing property IDs (propertyIdA, propertyIdB). Folder 1 creates a new portfolio for A and folder 6 deletes it with its holdings and records, so the collection can be repeated. The opportunities card depends on the stored opportunity scores of the database: it is OK or EMPTY. A card failure (status PARTIAL) cannot be caused from Postman; see the doc. Passwords are left empty: set them in your local environment and never commit them.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8091"
    },
    {
      "key": "keycloakUrl",
      "value": ""
    },
    {
      "key": "clientIdKc",
      "value": ""
    },
    {
      "key": "userA",
      "value": ""
    },
    {
      "key": "passwordA",
      "value": ""
    },
    {
      "key": "userB",
      "value": ""
    },
    {
      "key": "passwordB",
      "value": ""
    },
    {
      "key": "tokenA",
      "value": ""
    },
    {
      "key": "tokenB",
      "value": ""
    },
    {
      "key": "propertyIdA",
      "value": ""
    },
    {
      "key": "propertyIdB",
      "value": ""
    },
    {
      "key": "portfolioId",
      "value": ""
    },
    {
      "key": "holdingIdA",
      "value": ""
    },
    {
      "key": "holdingIdB",
      "value": ""
    },
    {
      "key": "unknownPortfolioId",
      "value": "999999999"
    }
  ],
  "item": [
    {
      "name": "0. Tokens",
      "item": [
        {
          "name": "Token for user A",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set('tokenA', pm.response.json().access_token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/x-www-form-urlencoded"
              }
            ],
            "url": {
              "raw": "{{keycloakUrl}}/protocol/openid-connect/token",
              "host": [
                "{{keycloakUrl}}"
              ],
              "path": [
                "protocol",
                "openid-connect",
                "token"
              ]
            },
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "client_id",
                  "value": "{{clientIdKc}}"
                },
                {
                  "key": "grant_type",
                  "value": "password"
                },
                {
                  "key": "username",
                  "value": "{{userA}}"
                },
                {
                  "key": "password",
                  "value": "{{passwordA}}"
                }
              ]
            }
          }
        },
        {
          "name": "Token for user B (another investor)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set('tokenB', pm.response.json().access_token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/x-www-form-urlencoded"
              }
            ],
            "url": {
              "raw": "{{keycloakUrl}}/protocol/openid-connect/token",
              "host": [
