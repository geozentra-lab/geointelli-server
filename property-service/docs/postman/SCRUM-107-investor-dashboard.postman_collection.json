    {
      "name": "1. Empty data",
      "item": [
        {
          "name": "A creates a new portfolio",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201', () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set('portfolioId', pm.response.json().id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{tokenA}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/portfolios",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "portfolios"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\"name\":\"SCRUM-107 Postman portfolio\"}"
            }
          }
        },
        {
          "name": "Portfolio without holdings: the portfolio cards are EMPTY",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "const d = pm.response.json();",
                  "const cards = [d.valueEquityDebt, d.incomeExpensesReturns, d.occupancyExposure, d.opportunities];",
                  "pm.test('scope of my portfolio', () => { pm.expect(d.scope).to.eql('PORTFOLIO'); pm.expect(d.portfolioId).to.eql(Number(pm.collectionVariables.get('portfolioId'))); pm.expect(d.portfolioCount).to.eql(1); });",
                  "pm.test('four cards, all loaded, same scope', () => {",
                  "  pm.expect(d.failedCards).to.eql([]);",
                  "  cards.forEach(c => { pm.expect(c).to.be.an('object'); pm.expect(c.status).to.be.oneOf(['OK', 'EMPTY']); pm.expect(c.error).to.eql(null); pm.expect(c.scope).to.eql(d.scope); pm.expect(c.portfolioId).to.eql(d.portfolioId); });",
                  "});",
                  "pm.test('income card uses the dashboard period', () => pm.expect(d.incomeExpensesReturns.period).to.eql(d.period));",
                  "pm.test('opportunities: items are flagged alreadyHeld', () => d.opportunities.items.forEach(i => pm.expect(i.alreadyHeld).to.be.a('boolean')));",
                  "pm.test('note', () => pm.expect(d.note).to.be.a('string'));",
                  "pm.test('value, income and occupancy cards are EMPTY with 0 holdings', () => {",
                  "  [d.valueEquityDebt, d.incomeExpensesReturns, d.occupancyExposure].forEach(c => { pm.expect(c.status).to.eql('EMPTY'); pm.expect(c.totalHoldings).to.eql(0); });",
                  "});",
                  "pm.test('income card: no records and projection unavailable, nothing invented', () => {",
                  "  pm.expect(d.incomeExpensesReturns.actual.status).to.eql('NO_RECORDS'); pm.expect(d.incomeExpensesReturns.actual.income).to.eql(0);",
                  "  pm.expect(d.incomeExpensesReturns.projected.status).to.eql('UNAVAILABLE');",
                  "});",
                  "pm.test('dashboard EMPTY when every card is empty, otherwise OK (stored opportunity scores)', () => {",
                  "  pm.expect(d.status).to.eql(d.opportunities.status === 'EMPTY' ? 'EMPTY' : 'OK');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{tokenA}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/dashboards/investor?portfolioId={{portfolioId}}&fromMonth=2026-01&toMonth=2026-03",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "dashboards",
                "investor"
              ],
              "query": [
                {
                  "key": "portfolioId",
                  "value": "{{portfolioId}}"
                },
                {
                  "key": "fromMonth",
                  "value": "2026-01"
                },
                {
                  "key": "toMonth",
                  "value": "2026-03"
                }
              ]
            }
          }
        }
      ]
    },
