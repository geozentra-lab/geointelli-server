                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "const d = pm.response.json();",
                  "const cards = [d.valueEquityDebt, d.incomeExpensesReturns, d.occupancyExposure, d.opportunities];",
                  "pm.test('scope of my portfolio', () => { pm.expect(d.scope).to.eql('PORTFOLIO'); pm.expect(d.portfolioId).to.eql(Number(pm.collectionVariables.get('portfolioId'))); pm.expect(d.portfolioCount).to.eql(1); });",
                  "pm.test('four cards, all loaded, same scope', () => {",
                  "  pm.expect(d.failedCards).to.eql([]);",
                  "  cards.forEach(c => { pm.expect(c).to.be.an('object'); pm.expect(c.status).to.be.oneOf(['OK', 'EMPTY']); pm.expect(c.error).to.eql(null); pm.expect(c.scope).to.eql(d.scope); pm.expect(c.portfolioId).to.eql(d.portfolioId); });",
                  "});",
                  "pm.test('income card uses the dashboard period', () => pm.expect(d.incomeExpensesReturns.period).to.eql(d.period));",
                  "pm.test('opportunities: items are flagged alreadyHeld', () => d.opportunities.items.forEach(i => pm.expect(i.alreadyHeld).to.be.a('boolean')));",
