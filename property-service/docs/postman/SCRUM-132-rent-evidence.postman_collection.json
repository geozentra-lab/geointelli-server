      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status 200', () => pm.response.to.have.status(200));",
              "const r = pm.response.json();",
              "pm.test('PARTIAL, asking missing', () => { pm.expect(r.coverage).to.eql('PARTIAL'); pm.expect(r.availableTypes).to.eql(['ACHIEVED']); pm.expect(r.missingTypes).to.eql(['ASKING']); });",
              "const o = r.observations.content[0];",
              "pm.test('currency, period, geography and source recorded', () => { pm.expect(o.currency).to.eql('USD'); pm.expect(o.rentPeriod).to.eql('MONTHLY'); pm.expect(o.convertedFrom).to.eql(null); pm.expect(o.geographyLevel).to.eql('TRACT'); pm.expect(o.source).to.eql('US_CENSUS_ACS'); pm.expect(o.sourceReleaseDate).to.eql('2024-12-12'); pm.expect(o.periodStart).to.eql('2019-01-01'); pm.expect(o.periodEnd).to.eql('2023-12-31'); });",
              "pm.test('median 1018 +/- 112, survey estimate', () => { pm.expect(Number(o.medianRent)).to.eql(1018); pm.expect(Number(o.medianRentMoe)).to.eql(112); pm.expect(o.observationKind).to.eql('ESTIMATE'); pm.expect(o.evidenceType).to.eql('ACHIEVED'); });",
              "pm.collectionVariables.set('tractRows', r.observations.totalElements);"
            ]
          }
        }
      ]
    },
