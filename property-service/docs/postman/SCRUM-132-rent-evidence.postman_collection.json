    {
      "name": "03 Empty data: tract 12001000201 before any import (200, NO_COVERAGE)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{userToken}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/rent-evidence?level=TRACT&code=12001000201",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "rent-evidence"
          ],
          "query": [
            {
              "key": "level",
              "value": "TRACT"
            },
            {
              "key": "code",
              "value": "12001000201"
            }
          ]
        },
        "description": "On a fresh database: NO_COVERAGE. On a database where the Census file is already loaded: PARTIAL (only the general checks apply)."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status 200', () => pm.response.to.have.status(200));",
              "const r = pm.response.json();",
              "pm.test('coverage reported, never a 404', () => pm.expect(['NO_COVERAGE','PARTIAL','AVAILABLE']).to.include(r.coverage));",
              "if (r.observations.totalElements === 0) pm.test('nothing imported yet: NO_COVERAGE with both types missing', () => { pm.expect(r.coverage).to.eql('NO_COVERAGE'); pm.expect(r.missingTypes).to.eql(['ASKING','ACHIEVED']); pm.expect(r.note).to.include('No asking or achieved'); });"
            ]
          }
        }
      ]
    },
    {
      "name": "04 Admin imports the Census ACS file from the staging folder (202)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{adminToken}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/admin/rent-evidence/import?stagedFile={{acsStagedFile}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "admin",
            "rent-evidence",
            "import"
          ],
          "query": [
            {
              "key": "stagedFile",
              "value": "{{acsStagedFile}}"
            }
          ]
        },
        "description": "The real file (4,732 Florida tracts, ACS 2019-2023 table B25064) is not in git: stage it under INGESTION_STAGING_DIRECTORY and set acsStagedFile to its relative path."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status 202', () => pm.response.to.have.status(202));",
              "pm.test('Location points at the job', () => pm.expect(pm.response.headers.get('Location')).to.include('/api/ingestion/jobs/'));",
              "const job = pm.response.json();",
              "pm.test('job queued for RENT_EVIDENCE', () => { pm.expect(job.dataset).to.eql('RENT_EVIDENCE'); pm.expect(job.jobType).to.eql('CSV_IMPORT'); });",
              "pm.collectionVariables.set('acsJobId', job.id);"
            ]
          }
        }
      ]
    },
    {
