{
  "info": {
    "_postman_id": "1db8a32e-84da-5813-9e0e-7d856899887b",
    "name": "SCRUM-132 Rent evidence ingestion",
    "description": "Manual checks for POST /api/admin/rent-evidence/import and GET /api/rent-evidence. Run in order. Set adminPassword and password, sampleDir (absolute path of docs/postman/samples/rent-evidence) and acsStagedFile (path of the prepared Census file inside INGESTION_STAGING_DIRECTORY). Poll requests repeat themselves while the job is QUEUED or RUNNING. Contract: docs/rent-evidence-ingestion.md.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "01 Token for the admin (Keycloak password grant)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/x-www-form-urlencoded"
          }
        ],
        "url": {
          "raw": "{{keycloakUrl}}/protocol/openid-connect/token",
          "host": [
            "{{keycloakUrl}}"
          ],
          "path": [
            "protocol",
            "openid-connect",
            "token"
          ]
        },
        "body": {
          "mode": "urlencoded",
          "urlencoded": [
            {
              "key": "client_id",
              "value": "{{clientId}}"
            },
            {
              "key": "grant_type",
              "value": "password"
            },
            {
              "key": "username",
              "value": "{{adminUser}}"
            },
            {
              "key": "password",
              "value": "{{adminPassword}}"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status 200', () => pm.response.to.have.status(200));",
              "pm.collectionVariables.set('adminToken', pm.response.json().access_token);"
            ]
          }
        }
      ]
    },
    {
