    {
      "name": "06 Poll the Census job (200, COMPLETED, 4,732 rows)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{adminToken}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/ingestion/jobs/{{acsJobId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "ingestion",
            "jobs",
            "{{acsJobId}}"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status 200', () => pm.response.to.have.status(200));",
              "const job = pm.response.json();",
              "const tries = Number(pm.collectionVariables.get('pollTries') || 0);",
              "if ((job.status === 'QUEUED' || job.status === 'RUNNING') && tries < 60) {",
              "  pm.collectionVariables.set('pollTries', tries + 1);",
              "  console.log('still ' + job.status + ', polling again');",
              "  setTimeout(() => {}, 2000);",
              "  pm.execution.setNextRequest(pm.info.requestName);",
              "  return;",
              "}",
              "pm.collectionVariables.set('pollTries', 0);",
              "pm.test('COMPLETED', () => pm.expect(job.status).to.eql('COMPLETED'));",
              "pm.test('4,732 rows, none failed', () => { pm.expect(job.total).to.eql(4732); pm.expect(job.completed).to.eql(4732); pm.expect(job.failed).to.eql(0); });"
            ]
          }
        }
      ]
    },
    {
      "name": "07 Read tract 12001000201 (200, PARTIAL: achieved Census rent, asking missing)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{userToken}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/rent-evidence?level=TRACT&code=12001000201",
