        {
          "name": "My effective permissions",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/users/me/entitlements",
            "description": "Expect normalUser=true. Professional flags reflect realm roles, not selected persona. Only visible lender organizations are listed. subscriptionPolicy=NOT_CONFIGURED."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Expected HTTP 200\", function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Property search",
