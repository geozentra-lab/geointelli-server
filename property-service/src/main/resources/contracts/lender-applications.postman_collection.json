    {
      "name": "Ownership checks - another valid user",
      "item": [
        {
          "name": "Foreign details",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/lender/applications/{{applicationId}}?organizationId={{organizationId}}",
            "description": "Set otherUserToken to a valid user who does not belong to this organization. Expected 404.",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{otherUserToken}}",
                  "type": "string"
                }
