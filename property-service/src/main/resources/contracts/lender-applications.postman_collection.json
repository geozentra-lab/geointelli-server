          ]
        },
        {
          "name": "Foreign pipeline",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/lender/pipeline?organizationId={{organizationId}}",
            "description": "Set otherUserToken to a valid user who does not belong to this organization. Expected 404.",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{otherUserToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
