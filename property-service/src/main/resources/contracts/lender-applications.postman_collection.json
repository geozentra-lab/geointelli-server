    },
    {
      "name": "Membership - optional existing user",
      "item": [
        {
          "name": "Read organization member IDs",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/lender/organizations/{{organizationId}}/members",
            "description": "200, includes owner."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));"
