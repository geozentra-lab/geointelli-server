        },
        {
          "name": "Owner grants member access",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/lender/organizations/{{organizationId}}/members",
            "description": "Set memberUserId to an existing local user ID. 204; repeats are no-ops.",
