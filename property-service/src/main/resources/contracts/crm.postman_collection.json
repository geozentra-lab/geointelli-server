{
  "info": {
    "name": "SCRUM-78 Clients, leads and activity",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Apply V21 to your test database first. Set baseUrl to the property-service port and token to a Keycloak access token. Run Clients, Leads and Activity in order. Requests create and edit test records; they never contact clients or send email. The client/lead groups retain a test lead and its contact for review because referenced clients cannot be deleted. Re-run Create client to start a fresh run. Empty accounts/lists return 200 with empty content. Empty history is normal for imported records without recorded events. All pages are zero based, newest ID first, size 1-100. There is no organization sharing or persona permission grant. The optional ownership folder needs otherToken from a different user and should be run after the first account setup. Notes are append-only new submissions, not idempotent. Clients normalize email case, require name and email or phone, and reject duplicate owner/email with 409. Leads use the Idempotency-Key header: same owner/key/normalized body replays with 200, different body conflicts with 409, a new key intentionally creates a new enquiry. NEW -> CONTACTED -> QUALIFIED -> CONVERTED; any open stage can become LOST. Terminal stages cannot reopen. No transaction/property/notification is created by conversion. Client deletion retains history and does not alter properties. No automatic lead deletion endpoint is part of this story."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8081"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "otherToken",
      "value": ""
    }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "Clients",
      "item": [
        {
          "name": "Create a test client and save its ID",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/clients",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Postman client\",\n  \"email\": \"{{clientEmail}}\",\n  \"phone\": \"+1 (305) 555-0100\",\n  \"notes\": \"SCRUM-78 manual check\"\n}"
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('clientEmail', 'crm-' + pm.variables.replaceIn('{{$guid}}') + '@example.com');",
                  "pm.collectionVariables.set('submissionKey', pm.variables.replaceIn('{{$guid}}'));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 201', () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set('clientId', String(pm.response.json().id));"
                ]
              }
            }
          ]
        },
        {
          "name": "List my clients",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/clients?page=0&size=20"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Read client",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/clients/{{clientId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
