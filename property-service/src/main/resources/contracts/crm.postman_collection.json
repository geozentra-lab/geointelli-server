                "value": "{{submissionKey}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"clientId\": {{clientId}},\n  \"title\": \"Residential enquiry\",\n  \"source\": \"WEBSITE\",\n  \"notes\": \"Asked for a viewing\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 201', () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set('leadId', String(pm.response.json().id));",
                  "pm.test('Starts NEW', () => pm.expect(pm.response.json().stage).to.eql('NEW'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Replay same submission: same ID, no duplicate event",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/leads",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{submissionKey}}"
