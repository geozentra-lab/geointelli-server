            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "pm.test('Same lead', () => pm.expect(String(pm.response.json().id)).to.eql(pm.collectionVariables.get('leadId')));"
                ]
              }
            }
          ]
        },
