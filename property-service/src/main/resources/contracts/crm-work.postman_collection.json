{
  "info": {
    "name": "SCRUM-79 CRM tasks and transaction pipeline",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Apply V23 after V21 and V22, set baseUrl and token, and replace propertyId with an existing property from your test database. Run setup, transaction and task folders in order. These requests create and edit test records; no messages, payments or ownership transfers are performed. Task statuses are separate from deal stages. Dates use UTC instants (dueAt, completedAt, closedAt) or a plain expectedCloseDate; due/planning dates support 1900-2199 and may be in the past. Empty accounts return empty pages and zero counts. All records use the authenticated owner, not persona or caller-supplied userId. Associations are validated snapshots and cannot be changed through PATCH. Lead/transaction links supply related IDs when omitted. Related client/property/lead must remain consistent at creation; existing deal snapshots survive later lead edits. Description/dueAt/expectedCloseDate accept explicit null; required title/status/stage cannot be cleared. No-op changes add no activity. Each POST intentionally creates a new task or deal. Transaction stages proceed PROSPECT -> VIEWING -> OFFER -> UNDER_CONTRACT -> CLOSED; open deals can cancel, terminal deals cannot reopen. Tasks can complete/cancel from OPEN or IN_PROGRESS, and reopen only to OPEN. Completion does not advance a deal or a lead. History is appended atomically with each real change, and deleted task history remains in the global activity feed. CRM records are scoped to the current user; organization sharing and reminder scheduling are outside this story. The optional ownership folder requires a second user token and must run before deletion. Linked contacts and the test deal are retained after the final task deletion."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8081"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "otherToken",
      "value": ""
    },
    {
      "key": "propertyId",
      "value": "100"
    }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "Setup: creates isolated test records (set propertyId first)",
      "item": [
        {
          "name": "Create test client",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/clients",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Pipeline test client\",\n  \"email\": \"{{testEmail}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 201', () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set('clientId', String(pm.response.json().id));"
                ]
              }
            },
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('testEmail', 'pipeline-' + pm.variables.replaceIn('{{$guid}}') + '@example.com');",
                  "pm.collectionVariables.set('setupKey', pm.variables.replaceIn('{{$guid}}'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Create a lead for an existing property",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/leads",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{setupKey}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"clientId\": {{clientId}},\n  \"propertyId\": {{propertyId}},\n  \"title\": \"Property enquiry\",\n  \"source\": \"MANUAL\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 201', () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set('leadId', String(pm.response.json().id));"
                ]
              }
            }
          ]
        },
        {
          "name": "Create property transaction",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/transactions",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Property deal\",\n  \"clientId\": {{clientId}},\n  \"leadId\": {{leadId}},\n  \"propertyId\": {{propertyId}},\n  \"expectedCloseDate\": \"2026-12-01\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 201', () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set('transactionId', String(pm.response.json().id));",
                  "pm.test('Starts PROSPECT', () => pm.expect(pm.response.json().stage).to.eql('PROSPECT'));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
