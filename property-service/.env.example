# Load these variables through your IDE/launcher when running Spring Boot.
# Spring Boot does not automatically load this .env file.
# Run with the local profile for a host-run app using local PostgreSQL or RDS.
# For example: mvn spring-boot:run -Dspring-boot.run.profiles=local

# APPLICATION - host-run listening port, or Docker's published host port.
APP_PORT=8081

# DATABASE - local PostgreSQL defaults
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_NAME=geozentra
DB_HOST=localhost
DB_PORT=5432
DB_SSL_MODE=prefer # "prefer" if local db while "verify-full" for rds
DB_SSL_ROOT_CERT=

# DATABASE - to use RDS, replace the values above (do not add duplicate keys):
# DB_HOST=your-instance.your-region.rds.amazonaws.com
# DB_PORT=5432
# DB_NAME=your_database
# DB_USER=your_database_user
# DB_PASSWORD=your_database_password
# DB_SSL_MODE=verify-full
# DB_SSL_ROOT_CERT=C:/absolute/path/to/rds-global-bundle.pem
# Use the RDS DNS endpoint so hostname verification matches its certificate.
# The CA file must exist on the machine running the application.

# DOCKER - independent of DB_HOST/DB_PORT used by a host-run application.
# Docker Compose passes these into the app as DB_HOST and DB_PORT.
DOCKER_DB_HOST=postgres
DOCKER_DB_PORT=5432
# For an RDS-backed app, use docker-compose.yml + docker-compose.rds.yml:
# Replace DOCKER_DB_HOST above with the RDS DNS endpoint and set the DB_NAME,
# DB_USER and DB_PASSWORD above to the RDS database credentials.
# The override enforces verify-full and sets the CA path inside the container.
# RDS_CA_BUNDLE_PATH=C:/absolute/path/to/rds-global-bundle.pem
# Keycloak continues to use the Compose postgres service.

# KEYCLOAK
KEYCLOAK_ADMIN=your_admin
KEYCLOAK_ADMIN_PASSWORD=your_password

AWS_ACCESS_KEY=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_REGION=your_aws_region

MAPILLARY_ACCESS_TOKEN=your_token_here
# Optional county street centerlines GeoJSON; absent data falls back to geometric ranking.
MAPILLARY_ROADS_FILE=

# Optional directory for local image testing via the localStorage qualifier.
IMAGES_LOCAL_DIRECTORY=images

# Concurrent property image tasks within each backend (1..8).
MAPILLARY_BACKFILL_WORKERS=2
